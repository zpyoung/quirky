{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "electrobun": [".hutch/devkit/api/sdks/main/index.ts", "types/electrobun-main.d.ts"],
      "electrobun/main": [".hutch/devkit/api/sdks/main/index.ts", "types/electrobun-main.d.ts"],
      "electrobun/view": [".hutch/devkit/api/browser/index.ts", "types/electrobun-main.d.ts"]
    }
  },
  "include": ["src", "test", "scripts", "electrobun.config.ts", "hutch.config.ts"]
}
