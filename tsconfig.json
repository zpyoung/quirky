{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@quirky/protocol": ["./packages/protocol/src/index.ts"],
      "@quirky/protocol/node": ["./packages/protocol/src/node/index.ts"]
    },
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  "include": [
    "packages/*/src",
    "packages/*/test",
    "plugins/*/*.ts",
    "plugins/*/src",
    "plugins/*/test",
    "scripts"
  ]
}
