{
  "id": "quirky.agent-status",
  "name": "Agent status",
  "version": "0.1.0",
  "description": "Turns agent hooks into a status row per session, the session's status and finish notifications.",
  "main": "main.ts",
  "cli": "cli.ts",
  "activation": "startup",
  "dependencies": [
    "quirky.session"
  ],
  "contributes": {
    "method": [
      {
        "id": "list",
        "description": "Sessions that have an agent status row, with the row's summary.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "worktree": {
              "type": "string",
              "description": "Only sessions of this worktree."
            }
          }
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "working",
                  "waiting",
                  "blocked",
                  "done"
                ]
              },
              "display": {
                "type": "string",
                "description": "What the window draws: working, monitoring, waiting, permission, blocked, failed, interrupted, done, unverifiable, idle or unconfirmed."
              },
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "One readable line; never a JSON object."
              },
              "progress": {
                "description": "0 to 100 as a percentage, or null when the program reports none."
              },
              "stateStartedAt": {
                "type": "number"
              },
              "evidenceAt": {
                "type": "number"
              },
              "restoredUnconfirmed": {
                "type": "boolean"
              },
              "sessionId": {
                "type": "string"
              },
              "agent": {
                "type": "string",
                "description": "The hook source that owns the row, e.g. claude or qwen-code."
              }
            },
            "required": [
              "state",
              "display",
              "label",
              "detail",
              "stateStartedAt",
              "evidenceAt",
              "restoredUnconfirmed",
              "sessionId",
              "agent"
            ]
          }
        }
      },
      {
        "id": "get",
        "description": "A session's agent status row with its display state at a time, or null when it has none.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string",
              "description": "The session ID."
            },
            "at": {
              "type": "number",
              "description": "The time to compute the display at, in ms since the epoch; defaults to now."
            }
          },
          "required": [
            "session"
          ]
        },
        "result": {
          "description": "The whole row plus `display` and `label`, or null."
        }
      },
      {
        "id": "explain",
        "description": "Why a session has its script state: the status row and the evidence behind it, the screen rule that matched, and which of them decided.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string",
              "description": "The session ID or name."
            },
            "at": {
              "type": "number",
              "description": "Judge the row's freshness at this time, in ms since the epoch; defaults to now."
            }
          },
          "required": [
            "session"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            },
            "name": {
              "description": "Null when absent."
            },
            "agent": {
              "description": "Null when absent."
            },
            "state": {
              "type": "string",
              "enum": [
                "working",
                "blocked",
                "idle",
                "unknown",
                "exited"
              ],
              "description": "The script state."
            },
            "kind": {
              "type": "string",
              "enum": [
                "approval",
                "question"
              ],
              "description": "Present when the state is blocked."
            },
            "decidedBy": {
              "type": "string",
              "enum": [
                "session",
                "rule",
                "row",
                "none"
              ]
            },
            "row": {
              "description": "The session's status row as it reads now; null when it has none.",
              "properties": {
                "state": {
                  "type": "string",
                  "enum": [
                    "working",
                    "waiting",
                    "blocked",
                    "done"
                  ]
                },
                "display": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                },
                "source": {
                  "type": "string",
                  "enum": [
                    "hook",
                    "replay",
                    "title",
                    "program-status",
                    "inference"
                  ]
                },
                "fresh": {
                  "type": "boolean",
                  "description": "Evidence under 30 minutes old and not restored unconfirmed."
                },
                "ageMs": {
                  "type": "number"
                },
                "because": {
                  "description": "The evidence that last changed the row; null for a row stored before explain existed.",
                  "properties": {
                    "source": {
                      "type": "string",
                      "enum": [
                        "hook",
                        "replay",
                        "title",
                        "program-status",
                        "inference"
                      ]
                    },
                    "rule": {
                      "type": "string"
                    },
                    "event": {
                      "type": "string"
                    },
                    "at": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "source",
                    "rule",
                    "at"
                  ]
                },
                "lead": {
                  "type": "object",
                  "properties": {
                    "state": {
                      "type": "string",
                      "enum": [
                        "working",
                        "waiting",
                        "blocked",
                        "done"
                      ]
                    },
                    "since": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "state",
                    "since"
                  ]
                },
                "children": {
                  "type": "object",
                  "properties": {
                    "agent": {
                      "type": "number"
                    },
                    "shell": {
                      "type": "number"
                    },
                    "cron": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "agent",
                    "shell",
                    "cron"
                  ]
                }
              },
              "required": [
                "state",
                "display",
                "label",
                "detail",
                "source",
                "fresh",
                "ageMs",
                "because",
                "lead",
                "children"
              ]
            },
            "screen": {
              "type": "object",
              "properties": {
                "origin": {
                  "description": "Where a rule set comes from; null when absent.",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "enum": [
                        "user",
                        "plugin",
                        "built-in"
                      ]
                    },
                    "path": {
                      "type": "string",
                      "description": "The file, for a user or built-in set."
                    },
                    "plugin": {
                      "type": "string"
                    },
                    "contribution": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                },
                "verdict": {
                  "description": "The rule that decided, or null.",
                  "properties": {
                    "rule": {
                      "type": "string"
                    },
                    "state": {
                      "type": "string",
                      "enum": [
                        "working",
                        "blocked",
                        "idle"
                      ]
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "approval",
                        "question"
                      ]
                    },
                    "origin": {
                      "type": "object",
                      "description": "Where a rule set comes from.",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "user",
                            "plugin",
                            "built-in"
                          ]
                        },
                        "path": {
                          "type": "string",
                          "description": "The file, for a user or built-in set."
                        },
                        "plugin": {
                          "type": "string"
                        },
                        "contribution": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    }
                  },
                  "required": [
                    "rule",
                    "state",
                    "origin"
                  ]
                },
                "pendingQuiet": {
                  "type": "string",
                  "description": "A rule that matches except that the screen has not been quiet long enough."
                },
                "ignored": {
                  "type": "array",
                  "description": "Sources skipped because they are invalid, with the reason.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "origin": {
                        "type": "object",
                        "description": "Where a rule set comes from.",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "enum": [
                              "user",
                              "plugin",
                              "built-in"
                            ]
                          },
                          "path": {
                            "type": "string",
                            "description": "The file, for a user or built-in set."
                          },
                          "plugin": {
                            "type": "string"
                          },
                          "contribution": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "origin",
                      "reason"
                    ]
                  }
                },
                "unavailable": {
                  "type": "string",
                  "description": "Why the rules could not be run."
                }
              },
              "required": [
                "origin",
                "verdict",
                "ignored"
              ]
            },
            "exit": {
              "type": "object",
              "properties": {
                "code": {
                  "description": "Null when absent."
                },
                "signal": {
                  "description": "Null when absent."
                }
              },
              "required": [
                "code",
                "signal"
              ]
            },
            "summary": {
              "type": "string",
              "description": "One sentence naming the state and why."
            }
          },
          "required": [
            "session",
            "name",
            "agent",
            "state",
            "decidedBy",
            "row",
            "screen",
            "summary"
          ]
        }
      },
      {
        "id": "rules",
        "description": "The effective detection rules of every agent that has any, where each comes from, and the sources skipped as invalid.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "origin": {
                "description": "Where a rule set comes from; null when absent.",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "user",
                      "plugin",
                      "built-in"
                    ]
                  },
                  "path": {
                    "type": "string",
                    "description": "The file, for a user or built-in set."
                  },
                  "plugin": {
                    "type": "string"
                  },
                  "contribution": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind"
                ]
              },
              "rules": {
                "type": "number",
                "description": "How many rules the effective set holds."
              },
              "ignored": {
                "type": "array",
                "description": "Sources skipped because they are invalid, with the reason.",
                "items": {
                  "type": "object",
                  "properties": {
                    "origin": {
                      "type": "object",
                      "description": "Where a rule set comes from.",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "user",
                            "plugin",
                            "built-in"
                          ]
                        },
                        "path": {
                          "type": "string",
                          "description": "The file, for a user or built-in set."
                        },
                        "plugin": {
                          "type": "string"
                        },
                        "contribution": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "kind"
                      ]
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "origin",
                    "reason"
                  ]
                }
              }
            },
            "required": [
              "agent",
              "origin",
              "rules",
              "ignored"
            ]
          }
        }
      },
      {
        "id": "ruleSet",
        "description": "The detection rules that apply to one agent and where they come from, or null when none does.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "The agent ID."
            }
          },
          "required": [
            "agent"
          ]
        },
        "result": {
          "properties": {
            "agent": {
              "type": "string"
            },
            "origin": {
              "type": "object",
              "description": "Where a rule set comes from.",
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "user",
                    "plugin",
                    "built-in"
                  ]
                },
                "path": {
                  "type": "string",
                  "description": "The file, for a user or built-in set."
                },
                "plugin": {
                  "type": "string"
                },
                "contribution": {
                  "type": "string"
                }
              },
              "required": [
                "kind"
              ]
            },
            "set": {
              "type": "object",
              "description": "The rule file: agent, optional description and the ordered rules."
            }
          },
          "required": [
            "agent",
            "origin",
            "set"
          ],
          "description": "Null when absent."
        }
      },
      {
        "id": "hooksStatus",
        "description": "Whether Quirky's hooks are installed for each agent that takes them from a config file.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "installed",
                  "not-installed",
                  "agent_disabled",
                  "cli_not_found",
                  "hooks_disabled",
                  "error"
                ]
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The files the installer may touch."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "status",
              "files"
            ]
          }
        }
      },
      {
        "id": "hooksSetup",
        "description": "Installs Quirky's hooks for detected, enabled agents, or for one named agent. Refused while the Agent status hooks setting is off.",
        "params": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "The agent ID; every agent when omitted."
            }
          }
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "installed",
                  "not-installed",
                  "agent_disabled",
                  "cli_not_found",
                  "hooks_disabled",
                  "error"
                ]
              },
              "changed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The files this run wrote."
              },
              "note": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "status",
              "changed"
            ]
          }
        }
      },
      {
        "id": "hooksRemove",
        "description": "Removes Quirky's hooks for every agent, or for one named agent.",
        "params": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "The agent ID; every agent when omitted."
            }
          }
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "changed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The files this run changed or deleted."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "changed"
            ]
          }
        }
      }
    ],
    "launch-hook": [
      {
        "id": "agent-hooks",
        "description": "Points Claude at the hook settings file for its version and Codex at the notify script.",
        "agents": [
          "claude",
          "claude-agent-teams",
          "codex"
        ]
      }
    ],
    "job": [
      {
        "id": "presence",
        "description": "Ends the rows of agents whose process has exited without saying so.",
        "interval": "10s",
        "initialDelay": "10s"
      }
    ],
    "setting": [
      {
        "id": "notifications",
        "type": "boolean",
        "title": "Notify when agents finish",
        "default": true
      },
      {
        "id": "hooks",
        "type": "boolean",
        "title": "Agent status hooks",
        "description": "Shows working, waiting, and done states in Quirky. Turn off to remove Quirky-managed hooks and stop reinstalling them.",
        "default": true
      }
    ],
    "event": [
      {
        "id": "changed",
        "description": "A session's agent status row changed or was removed.",
        "data": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "row": {
              "description": "The row after the change, or null when the row was removed."
            }
          },
          "required": [
            "sessionId"
          ]
        }
      }
    ],
    "cli-command": [
      {
        "id": "get",
        "words": "get",
        "summary": "show a session's agent status row, or null when it has none",
        "positionals": [
          {
            "name": "session",
            "description": "the session",
            "required": true
          }
        ],
        "flags": {
          "at": {
            "type": "number",
            "description": "compute the display state at this time, in ms since the epoch (default: now)"
          }
        },
        "methods": [
          "quirky.agent-status/get"
        ]
      },
      {
        "id": "explain",
        "words": "explain",
        "summary": "explain why a session is working, blocked, idle or unknown",
        "positionals": [
          {
            "name": "session",
            "description": "the session ID or name",
            "required": true
          }
        ],
        "flags": {
          "at": {
            "type": "number",
            "description": "judge the row's freshness at this time, in ms since the epoch (default: now)"
          }
        },
        "methods": [
          "quirky.agent-status/explain"
        ]
      },
      {
        "id": "rules-list",
        "words": "rules list",
        "summary": "list the detection rules in effect for each agent and where they come from",
        "methods": [
          "quirky.agent-status/rules"
        ]
      },
      {
        "id": "rules-show",
        "words": "rules show",
        "summary": "show the detection rules that apply to one agent",
        "positionals": [
          {
            "name": "agent",
            "description": "the agent ID",
            "required": true
          }
        ],
        "methods": [
          "quirky.agent-status/ruleSet"
        ]
      },
      {
        "id": "hooks-status",
        "words": "hooks status",
        "summary": "show whether agent status hooks are installed for each agent",
        "methods": [
          "quirky.agent-status/hooksStatus"
        ]
      },
      {
        "id": "hooks-setup",
        "words": "hooks setup",
        "summary": "install agent status hooks for detected agents, or for one agent",
        "positionals": [
          {
            "name": "agent",
            "description": "The agent ID; every agent when omitted.",
            "required": false
          }
        ],
        "methods": [
          "quirky.agent-status/hooksSetup"
        ]
      },
      {
        "id": "hooks-remove",
        "words": "hooks remove",
        "summary": "remove Quirky's agent status hooks for every agent, or for one agent",
        "positionals": [
          {
            "name": "agent",
            "description": "The agent ID; every agent when omitted.",
            "required": false
          }
        ],
        "methods": [
          "quirky.agent-status/hooksRemove"
        ]
      }
    ]
  }
}
