{
  "id": "quirky.agent-status",
  "name": "Agent status",
  "version": "0.1.0",
  "description": "Turns agent hooks into a status row per session, the session's status and finish notifications.",
  "main": "main.ts",
  "cli": "cli.ts",
  "activation": "startup",
  "dependencies": [
    "quirky.session"
  ],
  "contributes": {
    "method": [
      {
        "id": "list",
        "description": "Sessions that have an agent status row, with the row's summary.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "worktree": {
              "type": "string",
              "description": "Only sessions of this worktree."
            }
          }
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "state": {
                "type": "string",
                "enum": [
                  "working",
                  "waiting",
                  "blocked",
                  "done"
                ]
              },
              "display": {
                "type": "string",
                "description": "What the window draws: working, monitoring, waiting, permission, blocked, failed, interrupted, done, unverifiable, idle or unconfirmed."
              },
              "label": {
                "type": "string"
              },
              "detail": {
                "type": "string",
                "description": "One readable line; never a JSON object."
              },
              "progress": {
                "description": "0 to 100 as a percentage, or null when the program reports none."
              },
              "stateStartedAt": {
                "type": "number"
              },
              "evidenceAt": {
                "type": "number"
              },
              "restoredUnconfirmed": {
                "type": "boolean"
              },
              "sessionId": {
                "type": "string"
              },
              "agent": {
                "type": "string",
                "description": "The hook source that owns the row, e.g. claude or qwen-code."
              }
            },
            "required": [
              "state",
              "display",
              "label",
              "detail",
              "stateStartedAt",
              "evidenceAt",
              "restoredUnconfirmed",
              "sessionId",
              "agent"
            ]
          }
        }
      },
      {
        "id": "get",
        "description": "A session's agent status row with its display state at a time, or null when it has none.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string",
              "description": "The session ID."
            },
            "at": {
              "type": "number",
              "description": "The time to compute the display at, in ms since the epoch; defaults to now."
            }
          },
          "required": [
            "session"
          ]
        },
        "result": {
          "description": "The whole row plus `display` and `label`, or null."
        }
      },
      {
        "id": "hooksStatus",
        "description": "Whether Quirky's hooks are installed for each agent that takes them from a config file.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {}
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "installed",
                  "not-installed",
                  "agent_disabled",
                  "cli_not_found",
                  "hooks_disabled",
                  "error"
                ]
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The files the installer may touch."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "status",
              "files"
            ]
          }
        }
      },
      {
        "id": "hooksSetup",
        "description": "Installs Quirky's hooks for detected, enabled agents, or for one named agent. Refused while the Agent status hooks setting is off.",
        "params": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "The agent ID; every agent when omitted."
            }
          }
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "installed",
                  "not-installed",
                  "agent_disabled",
                  "cli_not_found",
                  "hooks_disabled",
                  "error"
                ]
              },
              "changed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The files this run wrote."
              },
              "note": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "status",
              "changed"
            ]
          }
        }
      },
      {
        "id": "hooksRemove",
        "description": "Removes Quirky's hooks for every agent, or for one named agent.",
        "params": {
          "type": "object",
          "properties": {
            "agent": {
              "type": "string",
              "description": "The agent ID; every agent when omitted."
            }
          }
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agent": {
                "type": "string"
              },
              "changed": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "The files this run changed or deleted."
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "agent",
              "changed"
            ]
          }
        }
      }
    ],
    "launch-hook": [
      {
        "id": "agent-hooks",
        "description": "Adds Claude's version-gated hooks through inline --settings JSON and Codex's notify script.",
        "agents": [
          "claude",
          "claude-agent-teams",
          "codex"
        ]
      }
    ],
    "job": [
      {
        "id": "presence",
        "description": "Ends the rows of agents whose process has exited without saying so.",
        "interval": "10s",
        "initialDelay": "10s"
      }
    ],
    "setting": [
      {
        "id": "hooks",
        "type": "boolean",
        "title": "Agent status hooks",
        "description": "Shows working, waiting, and done states in Quirky. Turn off to remove Quirky-managed hooks and stop reinstalling them.",
        "default": true
      }
    ],
    "event": [
      {
        "id": "changed",
        "description": "A session's agent status row changed or was removed.",
        "data": {
          "type": "object",
          "properties": {
            "sessionId": {
              "type": "string"
            },
            "row": {
              "description": "The row after the change, or null when the row was removed."
            }
          },
          "required": [
            "sessionId"
          ]
        }
      },
      {
        "id": "settled",
        "description": "A session's agent settled into done, waiting or blocked: a real change of state, never a replay or a session boundary.",
        "data": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "worktreeId": { "type": "string" },
            "agent": { "type": "string", "description": "The session's agent id." },
            "state": { "type": "string", "enum": ["done", "waiting", "blocked"] },
            "outcome": { "description": "success, cancellation or failure for a finished turn; null when the row carries none." },
            "interrupted": { "type": "boolean" },
            "prompt": { "description": "The turn's prompt, or null when there is none." },
            "toolName": { "description": "The tool the row is on or waits on, or null." },
            "toolInput": { "description": "That tool's input as one readable line, or null." },
            "lastAssistantMessage": { "description": "The agent's last message, or null." },
            "at": { "type": "number", "description": "When the row settled, in ms since the epoch." }
          },
          "required": ["sessionId", "worktreeId", "agent", "state", "interrupted", "at"]
        }
      }
    ],
    "cli-command": [
      {
        "id": "get",
        "words": "get",
        "summary": "show a session's agent status row, or null when it has none",
        "positionals": [
          {
            "name": "session",
            "description": "the session",
            "required": true
          }
        ],
        "flags": {
          "at": {
            "type": "number",
            "description": "compute the display state at this time, in ms since the epoch (default: now)"
          }
        },
        "methods": [
          "quirky.agent-status/get"
        ]
      },
      {
        "id": "hooks-status",
        "words": "hooks status",
        "summary": "show whether agent status hooks are installed for each agent",
        "methods": [
          "quirky.agent-status/hooksStatus"
        ]
      },
      {
        "id": "hooks-setup",
        "words": "hooks setup",
        "summary": "install agent status hooks for detected agents, or for one agent",
        "positionals": [
          {
            "name": "agent",
            "description": "The agent ID; every agent when omitted.",
            "required": false
          }
        ],
        "methods": [
          "quirky.agent-status/hooksSetup"
        ]
      },
      {
        "id": "hooks-remove",
        "words": "hooks remove",
        "summary": "remove Quirky's agent status hooks for every agent, or for one agent",
        "positionals": [
          {
            "name": "agent",
            "description": "The agent ID; every agent when omitted.",
            "required": false
          }
        ],
        "methods": [
          "quirky.agent-status/hooksRemove"
        ]
      }
    ]
  }
}
