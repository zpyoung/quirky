{
  "id": "quirky.worktree",
  "name": "Fake worktree",
  "version": "0.0.0",
  "main": "main.ts",
  "activation": "startup",
  "contributes": {
    "method": [
      {
        "id": "resolve",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": { "selector": { "type": "string" } },
          "required": ["selector"]
        }
      },
      {
        "id": "list",
        "readOnly": true,
        "params": { "type": "object", "properties": { "repo": { "type": "string" } } },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "repoId": { "type": "string" },
              "status": { "type": "string" },
              "kind": { "type": "string" },
              "branch": { "type": "string" },
              "head": { "type": "string" }
            },
            "required": ["id", "repoId", "status", "kind", "branch", "head"]
          }
        }
      },
      {
        "id": "testHoldResolve",
        "params": { "type": "object" }
      },
      {
        "id": "testWaitResolve",
        "readOnly": true,
        "params": { "type": "object" }
      },
      {
        "id": "testReleaseResolve",
        "params": { "type": "object" }
      }
    ]
  }
}
