{
  "id": "quirky.session",
  "apiVersion": "1.0.0",
  "name": "Fake session",
  "version": "0.0.0",
  "main": "main.ts",
  "activation": "startup",
  "contributes": {
    "method": [
      {
        "id": "seed",
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "id": "list",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "worktree": {
              "type": "string"
            }
          }
        }
      },
      {
        "id": "failNextList",
        "params": {
          "type": "object"
        }
      },
      {
        "id": "get",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            }
          },
          "required": [
            "session"
          ]
        }
      },
      {
        "id": "setStatus",
        "params": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "agentStatus": {
              "description": "The agent status summary, or null to clear it."
            }
          },
          "required": [
            "session",
            "status"
          ]
        }
      },
      {
        "id": "setProviderSession",
        "params": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            },
            "id": {
              "type": "string"
            },
            "transcriptPath": {
              "type": "string"
            }
          },
          "required": [
            "session",
            "id"
          ]
        }
      },
      {
        "id": "write",
        "params": {
          "type": "object",
          "properties": {
            "session": {
              "type": "string"
            },
            "data": {
              "type": "string"
            }
          },
          "required": [
            "session",
            "data"
          ]
        }
      },
      {
        "id": "calls",
        "readOnly": true,
        "params": {
          "type": "object"
        }
      },
      {
        "id": "remove",
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "id": "create",
        "params": {
          "type": "object",
          "additionalProperties": true
        }
      },
      {
        "id": "providerCalls",
        "readOnly": true,
        "params": {
          "type": "object"
        }
      }
    ],
    "event": [
      {
        "id": "changed"
      },
      {
        "id": "removed"
      }
    ]
  }
}
