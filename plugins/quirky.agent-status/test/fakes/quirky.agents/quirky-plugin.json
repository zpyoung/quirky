{
  "id": "quirky.agents",
  "name": "Fake agents",
  "version": "0.0.0",
  "main": "main.ts",
  "activation": "startup",
  "contributes": {
    "method": [
      { "id": "setCommand", "params": { "type": "object", "properties": { "command": { "type": "string" } }, "required": ["command"] } },
      { "id": "setAgents", "params": { "type": "object", "properties": { "agents": { "type": "array" } }, "required": ["agents"] } },
      { "id": "setDeliverDelay", "params": { "type": "object", "properties": { "ms": { "type": "number" } }, "required": ["ms"] } },
      { "id": "list", "readOnly": true, "params": { "type": "object" } },
      { "id": "get", "readOnly": true, "params": { "type": "object", "properties": { "agent": { "type": "string" } }, "required": ["agent"] } },
      { "id": "setPlan", "params": { "type": "object", "properties": { "agent": { "type": "string" }, "plan": {} }, "required": ["agent", "plan"] } },
      { "id": "submitPlan", "readOnly": true, "params": { "type": "object", "properties": { "agent": { "type": "string" }, "text": { "type": "string" } }, "required": ["agent"] } },
      { "id": "deliver", "params": { "type": "object", "additionalProperties": true } },
      { "id": "delivered", "readOnly": true, "params": { "type": "object" } }
    ]
  }
}
