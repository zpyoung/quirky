{
  "id": "quirky.hosting",
  "apiVersion": "1.0.0",
  "name": "Fake hosting",
  "version": "0.0.0",
  "main": "main.ts",
  "activation": "startup",
  "dependencies": ["quirky.worktree"],
  "contributes": {
    "method": [
      {
        "id": "forBranch",
        "readOnly": true,
        "params": {
