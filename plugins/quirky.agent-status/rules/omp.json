{
  "agent": "omp",
  "description": "OMP detection rules; it shares Pi's `π` title markers.",
  "rules": [
    {
      "id": "blocked-title",
      "why": "OMP writes `π ! <label>` (or `<name> - action required`) into its title when it waits on the user.",
      "state": "blocked",
      "kind": "approval",
      "region": "title",
      "all": [
        {
          "regex": "(?:^|[\\s|])(?:π|Pi|OMP)[ \\t]+!(?=\\s|$)|^\\s*(?:[⠀-⣿]\\s+)?(?:[Pp][Ii]|[Oo][Mm][Pp])\\s+-\\s+action required\\s*$"
        }
      ]
    },
    {
      "id": "working-title",
      "why": "OMP writes `π : <label>` or a braille spinner after the prefix into its title while a turn runs.",
      "state": "working",
      "region": "title",
      "all": [
        {
          "regex": "(?:^|[\\s|])(?:π|Pi|OMP)[ \\t]+:(?=\\s|$)|^\\s*π[ \\t]+[⠀-⣿]|^\\s*[⠀-⣿]\\s+(?:[Pp][Ii]|[Oo][Mm][Pp])\\s*$"
        }
      ]
    },
    {
      "id": "rest-title",
      "why": "OMP titles the pane `π - <session>` (or `π > <label>`) at rest, an explicit marker it writes itself.",
      "state": "idle",
      "region": "title",
      "all": [
        {
          "regex": "^\\s*(?:π|Pi|OMP)(?::|[ \\t]+[>-])(?=\\s|$)"
        }
      ],
      "none": [
        {
          "contains": "action required"
        }
      ]
    }
  ]
}
