{
  "id": "quirky.session",
  "name": "Session (test fake)",
  "version": "0.0.0",
  "main": "main.ts",
  "activation": "startup",
  "contributes": {
    "method": [
      {
        "id": "get",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": { "session": { "type": "string" } },
          "required": ["session"]
        }
      },
      {
        "id": "list",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": { "worktree": { "type": "string" } }
        }
      },
      {
        "id": "create",
        "params": {
          "type": "object",
          "properties": {
            "worktree": { "type": "string" },
            "agent": { "type": "string" },
            "cwd": { "type": "string" },
            "prompt": { "type": "string" },
            "title": { "type": "string" },
            "model": { "type": "string" },
            "options": {
              "type": "object",
              "additionalProperties": true
            },
            "extraArgs": { "type": "string" }
          }
        }
      },
      {
        "id": "register",
        "params": {
          "type": "object",
          "properties": {
            "worktree": { "type": "string" },
            "agent": { "type": "string" },
            "kind": { "type": "string", "enum": ["structured"] },
            "title": { "type": "string" }
          },
          "required": ["agent", "kind", "title"]
        }
      },
      {
        "id": "restore",
        "params": {
          "type": "object",
          "properties": { "session": { "type": "string" } },
          "required": ["session"]
        }
      },
      {
        "id": "close",
        "params": {
          "type": "object",
          "properties": { "session": { "type": "string" } },
          "required": ["session"]
        }
      }
    ],
    "event": [
      {
        "id": "removed",
        "description": "A session was closed.",
        "data": {
          "type": "object",
          "properties": { "sessionId": { "type": "string" } },
          "required": ["sessionId"]
        }
      },
      {
        "id": "changed",
        "description": "A session was created or changed.",
        "data": {
          "type": "object",
          "properties": { "session": { "type": "object" } },
          "required": ["session"]
        }
      }
    ]
  }
}
