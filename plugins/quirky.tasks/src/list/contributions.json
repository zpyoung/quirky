{
  "method": [
    {
      "id": "list",
      "description": "List bounded, per-repository GitHub issues or pull requests with source availability, provenance, pagination and partial failures.",
      "readOnly": true,
      "params": {
        "type": "object",
        "properties": {
          "worktree": { "type": "string", "description": "Optional existing worktree context used by the API caller." },
          "mode": { "type": "string", "enum": ["issues", "prs"] },
          "repoIds": { "description": "Repository IDs to include, or null for sticky all. Omit to use current Tasks navigation." },
          "query": { "type": "string", "description": "GitHub search query, limited to 8192 UTF-8 bytes." },
          "page": { "type": "integer", "minimum": 1 },
          "refresh": { "type": "boolean", "description": "Force a fresh provider read." },
          "noCache": { "type": "boolean", "description": "Force a fresh provider read." }
        }
      },
      "result": {
        "type": "object",
        "properties": {
          "items": { "type": "array", "items": { "type": "object", "description": "Bounded list-row item; body text is omitted. Workspace context is attached when linked.", "properties": { "kind": { "type": "string", "enum": ["issue", "pullRequest"] }, "number": { "type": "integer" }, "title": { "type": "string" }, "body": { "type": "string" }, "state": { "type": "string", "enum": ["open", "closed", "merged", "draft", "unknown"] }, "url": { "type": "string" }, "createdAt": {}, "updatedAt": {}, "author": {}, "labels": { "type": "array", "items": { "type": "string" } }, "assignees": { "type": "array", "items": { "type": "string" } }, "isDraft": { "type": "boolean" }, "headRefName": { "type": "string" }, "baseRefName": { "type": "string" }, "headRefOid": { "type": "string" }, "additions": { "type": "integer" }, "deletions": { "type": "integer" }, "changedFiles": { "type": "integer" }, "mergeStateStatus": { "type": "string" }, "reviewDecision": { "type": "string" }, "stateReason": { "type": "string" }, "duplicateOf": { "type": "integer" }, "worktree": { "type": "string" }, "repoId": { "type": "string" }, "repoName": { "type": "string" }, "linkedWorkspace": { "type": "object", "properties": { "name": { "type": "string" }, "worktree": { "type": "string" } } } }, "required": ["kind", "number", "title", "body", "state", "url", "createdAt", "updatedAt", "author", "labels", "assignees", "isDraft", "worktree", "repoId", "repoName"] } },
          "repositories": { "type": "array", "items": { "type": "object", "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "path": { "type": "string" }, "kind": { "type": "string" }, "displayName": {}, "worktree": { "type": "string" } }, "required": ["id", "name", "path", "kind", "worktree"] } },
          "page": { "type": "integer" },
          "totalPages": { "type": "integer" },
          "perRepo": { "type": "integer" },
          "failures": { "type": "array", "description": "Source, list or count failures; successful repository rows remain available.", "items": { "type": "object", "properties": { "repoId": { "type": "string" }, "message": { "type": "string" }, "reason": { "type": "string" }, "stage": { "type": "string" }, "source": { "type": "string" } }, "required": ["repoId", "message"] } },
          "sources": { "type": "object", "description": "Per-repository availability, authenticated host, origin, issue source and fallback provenance.", "additionalProperties": true }
        },
        "required": ["items", "repositories", "page", "totalPages", "perRepo", "failures", "sources"]
      }
    },
    {
      "id": "row",
      "description": "Apply a validated issue or pull-request row mutation through the public GitHub hosting API.",
      "destructive": true,
      "confirm": "Apply the requested GitHub Tasks row mutation?",
      "params": {
        "type": "object",
        "properties": {
          "worktree": { "type": "string" },
          "target": { "type": "object", "properties": { "worktree": { "type": "string" }, "kind": { "type": "string", "enum": ["issue", "pullRequest"] }, "number": { "type": "integer", "minimum": 1 }, "url": { "type": "string" }, "projectId": { "type": "string" }, "itemId": { "type": "string" }, "host": { "type": "string" }, "owner": { "type": "string" }, "repo": { "type": "string" } }, "required": ["worktree", "kind", "number"] },
          "action": { "type": "string", "enum": ["issueStatus", "assignees", "reviewers", "issueSource", "merge", "autoMerge"] },
          "state": { "type": "string", "enum": ["open", "closed"] },
          "stateReason": { "type": "string", "enum": ["completed", "not_planned", "duplicate"] },
          "duplicateOf": { "type": "integer", "minimum": 1, "description": "A positive, different issue number in the same repository." },
          "assignees": { "type": "array", "items": { "type": "string" }, "description": "Replace the issue assignee set; at most 100 values." },
          "reviewerAction": { "type": "string", "enum": ["add", "remove"] },
          "reviewerText": { "type": "string", "description": "Comma/space separated reviewer logins, at most 2048 UTF-8 bytes and 15 reviewers." },
          "logins": { "type": "array", "items": { "type": "string" }, "description": "At most 15 reviewer logins." },
          "preference": { "type": "string", "enum": ["origin", "upstream"] },
          "method": { "type": "string", "enum": ["squash", "merge", "rebase"] },
          "mergeAction": { "type": "string", "enum": ["direct", "queue"] },
          "expectedHead": { "type": "string", "description": "The confirmed current PR head SHA; the hosting API rechecks it before merge." },
          "confirmation": { "type": "string", "description": "Must be `<direct|queue> <method> PR #<number>` after user confirmation." },
          "autoMergeAction": { "type": "string", "enum": ["enable", "disable"] }
        },
        "required": ["target", "action"]
      },
      "result": { "type": "object", "description": "Explicit provider mutation outcome; queued/pending is never reported as merged.", "properties": { "kind": { "type": "string" }, "action": { "type": "string" }, "item": { "type": "object" }, "result": { "type": "object" }, "noChange": { "type": "boolean" } }, "required": ["kind"] }
    },
    {
      "id": "checks",
      "description": "Read bounded check status for a pull request row.",
      "readOnly": true,
      "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "target": { "type": "object", "properties": { "worktree": { "type": "string" }, "kind": { "type": "string", "enum": ["issue", "pullRequest"] }, "number": { "type": "integer", "minimum": 1 }, "url": { "type": "string" }, "host": { "type": "string" }, "owner": { "type": "string" }, "repo": { "type": "string" } }, "required": ["worktree", "kind", "number"] }, "noCache": { "type": "boolean" } }, "required": ["target"] },
      "result": { "type": "object", "description": "Hosting check rollup, bounded check rows, and partial failure metadata." }
    },
    {
      "id": "options",
      "description": "List bounded repository labels or assignable users, and recent pull-request participants, for Tasks pickers.",
      "readOnly": true,
      "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "repoId": { "type": "string" }, "kind": { "type": "string", "enum": ["labels", "assignees", "reviewers"] }, "query": { "type": "string" }, "target": { "type": "object", "properties": { "worktree": { "type": "string" }, "kind": { "type": "string", "enum": ["issue", "pullRequest"] }, "number": { "type": "integer", "minimum": 1 }, "url": { "type": "string" } }, "required": ["worktree", "kind", "number"] } }, "required": ["kind"] },
      "result": { "type": "object", "description": "Hosting label/assignee results, or reviewer participant and suggestion lists.", "properties": { "recentlyActive": { "type": "array", "items": { "type": "string" } }, "suggestions": { "type": "array", "items": { "type": "string" } }, "labels": { "type": "array", "items": { "type": "string" } }, "assignees": { "type": "array", "items": { "type": "object" } }, "totalCount": { "type": "integer" }, "truncated": { "type": "boolean" } } }
    },
    {
      "id": "mergeMetadata",
      "description": "Load current pull-request merge metadata before showing merge actions; absent safety metadata never enables merge.",
      "readOnly": true,
      "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "target": { "type": "object", "properties": { "worktree": { "type": "string" }, "kind": { "type": "string", "enum": ["issue", "pullRequest"] }, "number": { "type": "integer", "minimum": 1 }, "url": { "type": "string" }, "host": { "type": "string" }, "owner": { "type": "string" }, "repo": { "type": "string" } }, "required": ["worktree", "kind", "number"] } }, "required": ["target"] },
      "result": { "type": "object", "properties": { "kind": { "type": "string", "enum": ["loaded"] }, "number": { "type": "integer" }, "review": { "type": "object" }, "mergeMetadataKnown": { "type": "boolean" }, "mergeQueueRequired": { "description": "True, false, or null when the public provider could not confirm queue policy." }, "autoMergeAllowed": { "description": "True, false, or null when repository auto-merge capability is unknown." }, "mergeKnown": { "type": "boolean" }, "mergeEligible": { "type": "boolean" }, "queueEligible": { "type": "boolean" }, "autoMergeEnabled": { "type": "boolean" }, "autoMergeEnableEligible": { "type": "boolean" }, "directMethods": { "type": "array", "items": { "type": "string", "enum": ["squash", "merge", "rebase"] } }, "queueMethods": { "type": "array", "items": { "type": "string", "enum": ["squash", "merge", "rebase"] } } }, "required": ["kind", "number", "review", "mergeMetadataKnown", "mergeQueueRequired", "autoMergeAllowed", "mergeKnown", "mergeEligible", "queueEligible", "autoMergeEnabled", "autoMergeEnableEligible", "directMethods", "queueMethods"] }
    },
    {
      "id": "workspace",
      "description": "Resume, link, unlink, or start a real workspace for a GitHub task. Start returns a visible prefilled composer unless an explicit Project direct-start agent path is available.",
      "destructive": true,
      "confirm": "Create or change a workspace link for this GitHub item?",
      "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "target": { "type": "object", "properties": { "worktree": { "type": "string" }, "kind": { "type": "string", "enum": ["issue", "pullRequest"] }, "number": { "type": "integer", "minimum": 1 }, "url": { "type": "string" }, "projectId": { "type": "string" }, "itemId": { "type": "string" }, "host": { "type": "string" }, "owner": { "type": "string" }, "repo": { "type": "string" } }, "required": ["worktree", "kind", "number"] }, "action": { "type": "string", "enum": ["start", "resume", "link", "unlink"] }, "newWorkspace": { "type": "boolean" }, "name": { "type": "string" }, "setup": { "type": "string", "enum": ["run", "skip", "inherit"] }, "agent": { "type": "string" }, "prompt": { "type": "string" }, "trustSetup": { "type": "boolean", "description": "Only accepted after an explicit composer approval to run this untrusted setup once." }, "composerRequestId": { "type": "string", "description": "Active daemon-held composer request required when submitting the visible form." } }, "required": ["target", "action"] },
      "result": { "type": "object", "properties": { "kind": { "type": "string", "enum": ["created", "resumed", "linked", "unlinked", "composer"] }, "target": { "type": "object" }, "worktree": { "type": "object" }, "requestId": { "type": "string" }, "repoId": { "type": "string" }, "repoName": { "type": "string" }, "name": { "type": "string" }, "title": { "type": "string" }, "prompt": { "type": "string" }, "setup": { "type": "string" }, "agent": {}, "error": { "type": "string" } }, "required": ["kind"] }
    },
    {
      "id": "workspaceComposerState",
      "description": "Read the current daemon-owned visible workspace composer request, or null.",
      "readOnly": true,
      "params": { "type": "object", "properties": { "worktree": { "type": "string" } } },
      "result": { "description": "The pending composer request, or null when no request is open." }
    },
    {
      "id": "workspaceComposerCancel",
      "description": "Cancel the matching daemon-held workspace composer request without changing any workspace.",
      "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "requestId": { "type": "string" } }, "required": ["requestId"] },
      "result": { "description": "The remaining composer request, or null." }
    }
  ],
  "cli-command": [
    { "id": "list", "method": "list", "summary": "list bounded GitHub issues or pull requests across selected repositories" },
    { "id": "row", "method": "row", "summary": "update an issue or pull-request row through the safe hosting API" },
    { "id": "checks", "method": "checks", "summary": "read pull-request checks for a Tasks row" },
    { "id": "options", "method": "options", "summary": "list bounded labels, assignees, or pull-request reviewer suggestions" },
    { "id": "merge-metadata", "method": "mergeMetadata", "summary": "load pull-request merge metadata before confirmation" },
    { "id": "workspace", "method": "workspace", "summary": "link, resume, or start a workspace for a GitHub item" },
    { "id": "workspace-composer-state", "method": "workspaceComposerState", "summary": "read the current workspace composer request" },
    { "id": "workspace-composer-cancel", "method": "workspaceComposerCancel", "summary": "cancel the current workspace composer request" }
  ]
}
