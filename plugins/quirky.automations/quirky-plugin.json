{
  "id": "quirky.automations",
  "name": "Automations",
  "version": "0.1.0",
  "description": "Durable scheduled and manual structured agent runs.",
  "main": "main.ts",
  "ui": "dist/ui.js",
  "cli": "cli.ts",
  "activation": "startup",
  "contributes": {
    "method": [
      { "id": "uiState", "description": "Read daemon-owned automation navigation and retained editor draft.", "readOnly": true, "params": { "type": "object", "properties": {}, "additionalProperties": false }, "result": { "type": "object", "properties": { "revision": { "type": "integer" }, "navigation": { "type": "object", "additionalProperties": true }, "editor": {} }, "required": ["revision", "navigation", "editor"], "additionalProperties": false } },
      { "id": "uiNavigate", "description": "Set automation page, selection, filters and sort atomically.", "params": { "type": "object", "properties": { "page": { "type": "string", "enum": ["list", "detail", "runs", "run"] }, "automationId": {}, "runId": {}, "tab": { "type": "string", "enum": ["overview", "runs"] }, "query": { "type": "string" }, "host": { "type": "string" }, "status": { "type": "string", "enum": ["all", "enabled", "paused"] }, "lastRun": { "type": "string", "enum": ["all", "failed", "succeeded", "never"] }, "agent": { "type": "string" }, "sort": { "type": "string", "enum": ["name", "lastRun"] }, "direction": { "type": "string", "enum": ["asc", "desc"] }, "runQuery": { "type": "string" }, "runStatus": { "type": "string", "enum": ["all", "successful", "failed", "progress", "skipped"] } }, "additionalProperties": false }, "result": { "type": "object", "additionalProperties": true } },
      { "id": "open", "description": "Open Automations, retaining state and the prior view.", "params": { "type": "object", "additionalProperties": true }, "result": { "type": "object", "additionalProperties": true } },
      { "id": "close", "description": "Restore the view shown before Automations.", "params": { "type": "object", "properties": {}, "additionalProperties": false }, "result": { "type": "object", "properties": { "closed": { "type": "boolean" } }, "required": ["closed"] } },
      { "id": "settings", "description": "Open Automation settings even when its sidebar shortcut is hidden.", "params": { "type": "object", "properties": {}, "additionalProperties": false }, "result": { "type": "object", "properties": { "opened": { "type": "boolean" } }, "required": ["opened"] } },
      {
        "id": "list",
        "description": "Lists automation definitions in name order.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" }, "creationKey": { "type": "string" }, "name": { "type": "string" }, "prompt": { "type": "string" },
              "agentId": { "type": "string", "enum": ["claude", "codex"] }, "projectId": { "type": "string" },
              "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] }, "workspaceId": {}, "baseBranch": {},
              "setupDecision": { "type": "string", "enum": ["run", "skip"] }, "reuseSession": { "type": "boolean" },
              "runContext": {}, "sourceContext": {}, "launchOverrides": {}, "precheck": {}, "timezone": { "type": "string" },
              "rrule": { "type": "string" }, "dtstart": { "type": "integer" }, "enabled": { "type": "boolean" },
              "nextRunAt": { "type": "integer" }, "lastRunAt": { "type": "integer" },
              "missedRunPolicy": { "type": "string", "enum": ["run_once_within_grace"] }, "missedRunGraceMinutes": { "type": "integer" },
              "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" }
            },
            "required": ["id", "name", "prompt", "agentId", "projectId", "workspaceMode", "workspaceId", "baseBranch", "reuseSession", "runContext", "sourceContext", "launchOverrides", "precheck", "timezone", "rrule", "dtstart", "enabled", "nextRunAt", "missedRunPolicy", "missedRunGraceMinutes", "createdAt", "updatedAt"],
            "additionalProperties": false
          }
        }
      },
      {
        "id": "show",
        "description": "Returns one automation definition by ID.",
        "readOnly": true,
        "params": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "creationKey": { "type": "string" }, "name": { "type": "string" }, "prompt": { "type": "string" },
            "agentId": { "type": "string", "enum": ["claude", "codex"] }, "projectId": { "type": "string" },
            "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] }, "workspaceId": {}, "baseBranch": {},
            "setupDecision": { "type": "string", "enum": ["run", "skip"] }, "reuseSession": { "type": "boolean" },
            "runContext": {}, "sourceContext": {}, "launchOverrides": {}, "precheck": {}, "timezone": { "type": "string" },
            "rrule": { "type": "string" }, "dtstart": { "type": "integer" }, "enabled": { "type": "boolean" },
            "nextRunAt": { "type": "integer" }, "lastRunAt": { "type": "integer" },
            "missedRunPolicy": { "type": "string", "enum": ["run_once_within_grace"] }, "missedRunGraceMinutes": { "type": "integer" },
            "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" }
          },
          "required": ["id", "name", "prompt", "agentId", "projectId", "workspaceMode", "workspaceId", "baseBranch", "reuseSession", "runContext", "sourceContext", "launchOverrides", "precheck", "timezone", "rrule", "dtstart", "enabled", "nextRunAt", "missedRunPolicy", "missedRunGraceMinutes", "createdAt", "updatedAt"],
          "additionalProperties": false
        }
      },
      {
        "id": "create",
        "description": "Creates a validated scheduled automation; project and workspace values are stored as identifiers only.",
        "params": {
          "type": "object",
          "properties": {
            "creationKey": { "type": "string" }, "name": { "type": "string" }, "prompt": { "type": "string" },
            "agentId": { "type": "string", "enum": ["claude", "codex"] }, "projectId": { "type": "string" },
            "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] }, "workspaceId": {}, "baseBranch": {}, "setupDecision": {},
            "reuseSession": { "type": "boolean" }, "runContext": { "description": "Run metadata object or null; at most 65536 serialized UTF-8 JSON bytes." }, "sourceContext": { "description": "Source metadata object or null; at most 65536 serialized UTF-8 JSON bytes." }, "launchOverrides": {}, "precheck": {},
            "timezone": { "type": "string" }, "rrule": { "type": "string" }, "dtstart": { "type": "integer", "minimum": 0 },
            "enabled": { "type": "boolean" }, "missedRunGraceMinutes": { "type": "integer", "minimum": 0 }
          },
          "required": ["prompt", "agentId", "projectId", "rrule"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "creationKey": { "type": "string" }, "name": { "type": "string" }, "prompt": { "type": "string" },
            "agentId": { "type": "string", "enum": ["claude", "codex"] }, "projectId": { "type": "string" },
            "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] }, "workspaceId": {}, "baseBranch": {},
            "setupDecision": { "type": "string", "enum": ["run", "skip"] }, "reuseSession": { "type": "boolean" },
            "runContext": {}, "sourceContext": {}, "launchOverrides": {}, "precheck": {}, "timezone": { "type": "string" },
            "rrule": { "type": "string" }, "dtstart": { "type": "integer" }, "enabled": { "type": "boolean" },
            "nextRunAt": { "type": "integer" }, "lastRunAt": { "type": "integer" },
            "missedRunPolicy": { "type": "string", "enum": ["run_once_within_grace"] }, "missedRunGraceMinutes": { "type": "integer" },
            "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" }
          },
          "required": ["id", "name", "prompt", "agentId", "projectId", "workspaceMode", "workspaceId", "baseBranch", "reuseSession", "runContext", "sourceContext", "launchOverrides", "precheck", "timezone", "rrule", "dtstart", "enabled", "nextRunAt", "missedRunPolicy", "missedRunGraceMinutes", "createdAt", "updatedAt"],
          "additionalProperties": false
        }
      },
      {
        "id": "edit",
        "description": "Partially edits an automation; omitted fields are preserved and explicit null clears nullable fields.",
        "params": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "name": { "type": "string" }, "prompt": { "type": "string" },
            "agentId": { "type": "string", "enum": ["claude", "codex"] }, "projectId": { "type": "string" },
            "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] }, "workspaceId": {}, "baseBranch": {}, "setupDecision": {},
            "reuseSession": { "type": "boolean" }, "runContext": { "description": "Run metadata object or null; at most 65536 serialized UTF-8 JSON bytes." }, "sourceContext": { "description": "Source metadata object or null; at most 65536 serialized UTF-8 JSON bytes." }, "launchOverrides": {}, "precheck": {},
            "timezone": { "type": "string" }, "rrule": { "type": "string" }, "dtstart": { "type": "integer", "minimum": 0 },
            "enabled": { "type": "boolean" }, "missedRunGraceMinutes": { "type": "integer", "minimum": 0 }
          },
          "required": ["id"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "creationKey": { "type": "string" }, "name": { "type": "string" }, "prompt": { "type": "string" },
            "agentId": { "type": "string", "enum": ["claude", "codex"] }, "projectId": { "type": "string" },
            "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] }, "workspaceId": {}, "baseBranch": {},
            "setupDecision": { "type": "string", "enum": ["run", "skip"] }, "reuseSession": { "type": "boolean" },
            "runContext": {}, "sourceContext": {}, "launchOverrides": {}, "precheck": {}, "timezone": { "type": "string" },
            "rrule": { "type": "string" }, "dtstart": { "type": "integer" }, "enabled": { "type": "boolean" },
            "nextRunAt": { "type": "integer" }, "lastRunAt": { "type": "integer" },
            "missedRunPolicy": { "type": "string", "enum": ["run_once_within_grace"] }, "missedRunGraceMinutes": { "type": "integer" },
            "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" }
          },
          "required": ["id", "name", "prompt", "agentId", "projectId", "workspaceMode", "workspaceId", "baseBranch", "reuseSession", "runContext", "sourceContext", "launchOverrides", "precheck", "timezone", "rrule", "dtstart", "enabled", "nextRunAt", "missedRunPolicy", "missedRunGraceMinutes", "createdAt", "updatedAt"],
          "additionalProperties": false
        }
      },
      {
        "id": "remove",
        "description": "Deletes a definition and all its run history without removing workspaces.",
        "destructive": true,
        "confirm": "Delete this automation and its run history? Existing workspaces are not removed.",
        "params": { "type": "object", "properties": { "id": { "type": "string" }, "yes": { "type": "boolean" } }, "required": ["id"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "id": { "type": "string" }, "removed": { "type": "boolean" } }, "required": ["id", "removed"], "additionalProperties": false }
      },
      {
        "id": "run",
        "description": "Queues a manual pending run, including when the definition is paused.",
        "params": { "type": "object", "properties": { "id": { "type": "string" } }, "required": ["id"], "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "automationId": { "type": "string" }, "title": { "type": "string" }, "runNumber": { "type": "integer" },
            "scheduledFor": { "type": "integer" }, "trigger": { "type": "string", "enum": ["scheduled", "manual"] },
            "status": { "type": "string", "enum": ["pending", "dispatching", "dispatched", "completed", "skipped_precheck", "skipped_missed", "skipped_unavailable", "skipped_needs_interactive_auth", "dispatch_failed"] },
            "createdAt": { "type": "integer" }, "startedAt": { "type": "integer" }, "dispatchedAt": { "type": "integer" }, "completedAt": { "type": "integer" },
            "occurrenceCount": { "type": "integer" }, "lastOccurrenceAt": { "type": "integer" }, "runContext": {}, "sourceContext": {},
            "workspaceId": {}, "workspaceDisplayName": {}, "sessionKind": { "type": "string", "enum": ["structured"] }, "sessionId": {},
            "launchSettings": {}, "outputSnapshot": {}, "precheckResult": {}, "usage": {}, "error": {}
          },
          "required": ["id", "automationId", "title", "runNumber", "scheduledFor", "trigger", "status", "createdAt", "occurrenceCount", "runContext", "sourceContext", "workspaceId", "sessionKind", "sessionId", "launchSettings", "error"],
          "additionalProperties": false
        }
      },
      {
        "id": "runs",
        "description": "Reads retained run history with a stable cursor.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": { "automationId": { "type": "string" }, "limit": { "type": "integer" }, "cursor": { "type": "string" } },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "runs": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }, "automationId": { "type": "string" }, "title": { "type": "string" }, "runNumber": { "type": "integer" },
                  "scheduledFor": { "type": "integer" }, "trigger": { "type": "string", "enum": ["scheduled", "manual"] },
                  "status": { "type": "string", "enum": ["pending", "dispatching", "dispatched", "completed", "skipped_precheck", "skipped_missed", "skipped_unavailable", "skipped_needs_interactive_auth", "dispatch_failed"] },
                  "createdAt": { "type": "integer" }, "startedAt": { "type": "integer" }, "dispatchedAt": { "type": "integer" }, "completedAt": { "type": "integer" },
                  "occurrenceCount": { "type": "integer" }, "lastOccurrenceAt": { "type": "integer" }, "runContext": {}, "sourceContext": {},
                  "workspaceId": {}, "workspaceDisplayName": {}, "sessionKind": { "type": "string", "enum": ["structured"] }, "sessionId": {},
                  "launchSettings": {}, "outputSnapshot": {}, "precheckResult": {}, "usage": {}, "error": {}
                },
                "required": ["id", "automationId", "title", "runNumber", "scheduledFor", "trigger", "status", "createdAt", "occurrenceCount", "runContext", "sourceContext", "workspaceId", "sessionKind", "sessionId", "launchSettings", "error"],
                "additionalProperties": false
              }
            },
            "nextCursor": {}
          },
          "required": ["runs", "nextCursor"],
          "additionalProperties": false
        }
      },
      {
        "id": "schedule",
        "description": "Inspects schedule validity, label, next occurrence and latest occurrence in an explicit timezone.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "rrule": { "type": "string" }, "timezone": { "type": "string" }, "dtstart": { "type": "integer", "minimum": 0 },
            "after": { "type": "integer", "minimum": 0 }, "now": { "type": "integer", "minimum": 0 }
          },
          "required": ["rrule", "timezone", "dtstart", "after"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "valid": { "type": "boolean" }, "runnable": { "type": "boolean" },
            "description": {
              "type": "object",
              "properties": {
                "kind": { "type": "string", "enum": ["hourly", "daily", "weekdays", "weekly", "custom", "invalid"] },
                "label": { "type": "string" }, "hour": { "type": "integer" }, "minute": { "type": "integer" }, "day": { "type": "integer" }
              },
              "required": ["kind", "label"], "additionalProperties": false
            },
            "next": {}, "latest": {}
          },
          "required": ["valid", "runnable", "description", "next", "latest"],
          "additionalProperties": false
        }
      },
      {
        "id": "tick",
        "description": "Evaluates due schedules using the daemon's current time.",
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": { "type": "object", "properties": { "now": { "type": "integer" }, "evaluated": { "type": "integer" } }, "required": ["now", "evaluated"], "additionalProperties": false }
      },
      {
        "id": "claim",
        "description": "Atomically claims a pending run for dispatch ownership without launching it.",
        "params": { "type": "object", "properties": { "runId": { "type": "string" } }, "required": ["runId"], "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "automationId": { "type": "string" }, "title": { "type": "string" }, "runNumber": { "type": "integer" },
            "scheduledFor": { "type": "integer" }, "trigger": { "type": "string", "enum": ["scheduled", "manual"] },
            "status": { "type": "string", "enum": ["pending", "dispatching", "dispatched", "completed", "skipped_precheck", "skipped_missed", "skipped_unavailable", "skipped_needs_interactive_auth", "dispatch_failed"] },
            "createdAt": { "type": "integer" }, "startedAt": { "type": "integer" }, "dispatchedAt": { "type": "integer" }, "completedAt": { "type": "integer" },
            "occurrenceCount": { "type": "integer" }, "lastOccurrenceAt": { "type": "integer" }, "runContext": {}, "sourceContext": {},
            "workspaceId": {}, "workspaceDisplayName": {}, "sessionKind": { "type": "string", "enum": ["structured"] }, "sessionId": {},
            "launchSettings": {}, "outputSnapshot": {}, "precheckResult": {}, "usage": {}, "error": {}
          },
          "required": ["id", "automationId", "title", "runNumber", "scheduledFor", "trigger", "status", "createdAt", "occurrenceCount", "runContext", "sourceContext", "workspaceId", "sessionKind", "sessionId", "launchSettings", "error"],
          "additionalProperties": false
        }
      },
      {
        "id": "updateRun",
        "description": "Records structured dispatch evidence and an allowed run status transition.",
        "params": {
          "type": "object",
          "properties": {
            "runId": { "type": "string" },
            "patch": {
              "type": "object",
              "properties": {
                "status": { "type": "string", "enum": ["pending", "dispatching", "dispatched", "completed", "skipped_precheck", "skipped_missed", "skipped_unavailable", "skipped_needs_interactive_auth", "dispatch_failed"] },
                "workspaceId": {}, "workspaceDisplayName": {}, "sessionId": {}, "launchSettings": { "description": "Launch metadata object or null; at most 65536 serialized UTF-8 JSON bytes." }, "outputSnapshot": {},
                "precheckResult": { "description": "Precheck evidence object or null; at most 65536 serialized UTF-8 JSON bytes." }, "usage": { "description": "Usage evidence object or null; at most 65536 serialized UTF-8 JSON bytes." }, "error": {}
              },
              "additionalProperties": false
            }
          },
          "required": ["runId", "patch"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "automationId": { "type": "string" }, "title": { "type": "string" }, "runNumber": { "type": "integer" },
            "scheduledFor": { "type": "integer" }, "trigger": { "type": "string", "enum": ["scheduled", "manual"] },
            "status": { "type": "string", "enum": ["pending", "dispatching", "dispatched", "completed", "skipped_precheck", "skipped_missed", "skipped_unavailable", "skipped_needs_interactive_auth", "dispatch_failed"] },
            "createdAt": { "type": "integer" }, "startedAt": { "type": "integer" }, "dispatchedAt": { "type": "integer" }, "completedAt": { "type": "integer" },
            "occurrenceCount": { "type": "integer" }, "lastOccurrenceAt": { "type": "integer" }, "runContext": {}, "sourceContext": {},
            "workspaceId": {}, "workspaceDisplayName": {}, "sessionKind": { "type": "string", "enum": ["structured"] }, "sessionId": {},
            "launchSettings": {}, "outputSnapshot": {}, "precheckResult": {}, "usage": {}, "error": {}
          },
          "required": ["id", "automationId", "title", "runNumber", "scheduledFor", "trigger", "status", "createdAt", "occurrenceCount", "runContext", "sourceContext", "workspaceId", "sessionKind", "sessionId", "launchSettings", "error"],
          "additionalProperties": false
        }
      }
    ],
    "event": [
      { "id": "changed", "description": "An automation definition or run changed after its durable write completed." },
      { "id": "uiChanged", "description": "Automation navigation or retained editor draft changed." }
    ],
    "view": [
      { "id": "automations", "title": "Automations" },
      { "id": "settings", "title": "Automations", "settings": true }
    ],
    "sidebar-section": [{ "id": "automations", "title": "Automations", "order": 35 }],
    "setting": [
      { "id": "show-automations-button", "title": "Show Automations Button", "description": "Show the Automations shortcut in the sidebar.", "type": "boolean", "default": true, "menu": "view" },
      { "id": "ask-before-delete", "title": "Ask Before Deleting Automations", "description": "Confirm deleting automations and their run history.", "type": "boolean", "default": true }
    ],
    "command": [
      { "id": "open", "title": "Open Automations" },
      { "id": "settings", "title": "Automation settings" }
    ],
    "cli-command": [
      { "id": "uiState", "words": "ui-state", "summary": "read automation view and draft state", "methods": ["quirky.automations/uiState"] },
      { "id": "uiNavigate", "words": "navigate", "summary": "set automation navigation with a JSON patch", "flags": { "patch": { "type": "string", "description": "JSON navigation patch", "required": true } }, "methods": ["quirky.automations/uiNavigate"] },
      { "id": "open", "words": "open", "summary": "open the automation page", "flags": { "patch": { "type": "string", "description": "JSON navigation patch" } }, "methods": ["quirky.automations/open"] },
      { "id": "close", "words": "close", "summary": "restore the preceding view", "methods": ["quirky.automations/close"] },
      { "id": "settings", "words": "settings", "summary": "open automation settings", "methods": ["quirky.automations/settings"] },
      { "id": "list", "words": "list", "summary": "list scheduled automations", "methods": ["quirky.automations/list"] },
      { "id": "show", "words": "show", "summary": "show an automation", "positionals": [{ "name": "id", "description": "automation ID", "required": false }], "flags": { "id": { "type": "string", "description": "automation ID as an alternative to the positional ID" } }, "methods": ["quirky.automations/show"] },
      {
        "id": "create",
        "words": "create",
        "summary": "create a scheduled automation",
        "flags": {
          "name": { "type": "string", "description": "automation name", "required": true }, "prompt": { "type": "string", "description": "structured agent prompt", "required": true },
          "provider": { "type": "string", "description": "claude or codex", "required": true, "enum": ["claude", "codex"] },
          "project": { "type": "string", "description": "project identity; no target resolution is performed" }, "repo": { "type": "string", "description": "project identity alias for --project" },
          "workspace": { "type": "string", "description": "existing workspace identity" }, "workspace-mode": { "type": "string", "description": "existing or new-per-run", "enum": ["existing", "new-per-run", "new_per_run"] },
          "base-branch": { "type": "string", "description": "base branch for new-per-run workspaces" }, "setup-decision": { "type": "string", "description": "run or skip setup for new workspaces", "enum": ["run", "skip"] },
          "trigger": { "type": "string", "description": "hourly, daily, weekdays, weekly, or a raw schedule" }, "schedule": { "type": "string", "description": "alias for --trigger" },
          "time": { "type": "string", "description": "H:MM/HH:MM 24-hour time for daily, weekdays or weekly" }, "day": { "type": "string", "description": "weekly day 0-6, Sunday is 0" },
          "timezone": { "type": "string", "description": "saved IANA timezone" }, "enabled": { "type": "boolean", "description": "enable the schedule" },
          "disabled": { "type": "boolean", "description": "create paused" }, "missed-run-grace-minutes": { "type": "integer", "description": "missed-run grace in minutes; zero is allowed" },
          "reuse-session": { "type": "boolean", "description": "reuse the prior live session for an existing workspace" }, "fresh-session": { "type": "boolean", "description": "use a fresh structured session" },
          "precheck": { "type": "string", "description": "stored precheck command; not run by core" }, "precheck-timeout": { "type": "integer", "description": "precheck timeout from 1 to 600 seconds" },
