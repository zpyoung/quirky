{
  "contributes": {
    "method": [
      {
        "id": "editorData",
        "description": "Reads the local project, workspace, and structured-agent catalogs for the automation editor.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "hosts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }, "label": { "type": "string" },
                  "available": { "type": "boolean" }, "reason": { "type": "string" }
                },
                "required": ["id", "label", "available"],
                "additionalProperties": false
              }
            },
            "projects": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }, "name": { "type": "string" },
                  "hostId": { "type": "string", "enum": ["local"] }, "path": { "type": "string" }, "kind": { "type": "string" }
                },
                "required": ["id", "name", "hostId", "path", "kind"],
                "additionalProperties": false
              }
            },
            "workspaces": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" }, "repoId": { "type": "string" }, "name": { "type": "string" },
                  "path": { "type": "string" }, "isMain": { "type": "boolean" }
                },
                "required": ["id", "repoId", "name", "path", "isMain"],
                "additionalProperties": false
              }
            },
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "enum": ["claude", "codex"] }, "label": { "type": "string" },
                  "enabled": { "type": "boolean" }, "installed": { "type": "boolean" }, "isDefault": { "type": "boolean" }
                },
                "required": ["id", "label", "enabled", "installed", "isDefault"],
                "additionalProperties": false
              }
            },
            "errors": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["hosts", "projects", "workspaces", "agents", "errors"],
          "additionalProperties": false
        }
      },
      {
        "id": "openEditor",
        "description": "Opens a new automation editor or rereads an existing definition into the retained draft.",
        "params": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "template": { "type": "string", "enum": ["repo-health-weekday", "release-prep-weekly", "recurring-review-daily", "maintenance-hourly"] }
          },
          "additionalProperties": false
        },
        "result": { "type": "object", "description": "Updated daemon-owned automation UI state.", "additionalProperties": true }
      },
      {
        "id": "patchDraft",
        "description": "Validates and stores a partial automation draft, applying workspace/session and agent override coupling.",
        "params": {
          "type": "object",
          "properties": {
            "patch": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "prompt": { "type": "string" },
                "agentId": { "type": "string", "enum": ["claude", "codex"] },
                "projectId": { "type": "string" },
                "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] },
                "workspaceId": { "description": "Workspace ID string or null." },
                "baseBranch": { "description": "Base branch string or null." },
                "setupDecision": { "type": "string", "enum": ["run", "skip"] },
                "reuseSession": { "type": "boolean" },
                "timezone": { "type": "string" },
                "rrule": { "type": "string" },
                "missedRunGraceMinutes": { "type": "integer", "enum": [0, 30, 60, 180, 720, 1440, 2880] },
                "precheck": {
                  "description": "Null to clear, or a precheck object with command and timeoutSeconds.",
                  "properties": {
                    "command": { "type": "string" },
                    "timeoutSeconds": { "type": "integer", "enum": [30, 60, 120, 300, 600] }
                  },
                  "required": ["command", "timeoutSeconds"],
                  "additionalProperties": false
                },
                "launchOverrides": {
                  "description": "Null to clear, or structured model and optionValues overrides.",
                  "properties": {
                    "model": { "type": "string" },
                    "optionValues": { "type": "object", "description": "Option IDs map to string or boolean values.", "additionalProperties": true }
                  },
                  "additionalProperties": false
                },
                "runContext": { "description": "Opaque run context object or null; not editable.", "additionalProperties": true },
                "sourceContext": { "description": "Opaque source context object or null; not editable.", "additionalProperties": true }
              },
              "additionalProperties": false
            },
            "template": { "type": "string", "enum": ["repo-health-weekday", "release-prep-weekly", "recurring-review-daily", "maintenance-hourly"] }
          },
          "required": ["patch"],
          "additionalProperties": false
        },
        "result": { "type": "object", "description": "Updated daemon-owned automation UI state.", "additionalProperties": true }
      },
      {
        "id": "saveEditor",
        "description": "Validates the retained draft and creates or partially updates its automation definition.",
        "params": {
          "type": "object",
          "properties": {
            "trustSetup": {
              "type": "boolean",
              "description": "Explicit UI confirmation was followed by repo/trustHooks at the inspected immutable revision; this flag never grants hook trust by itself."
            }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" }, "creationKey": { "type": "string" },
            "owner": {
              "description": "Captured local owner object or null.",
              "properties": {
                "kind": { "type": "string", "enum": ["local"] },
                "repoId": { "type": "string" },
                "repoPath": { "type": "string" },
                "workspaceId": { "description": "Workspace ID string or null." },
                "workspacePath": { "description": "Workspace path string or null." },
                "workspaceInstanceId": { "description": "Filesystem instance ID string or null." }
              },
              "required": ["kind", "repoId", "repoPath", "workspaceId", "workspacePath", "workspaceInstanceId"],
              "additionalProperties": false
            },
            "name": { "type": "string" }, "prompt": { "type": "string" },
            "agentId": { "type": "string", "enum": ["claude", "codex"] }, "projectId": { "type": "string" },
            "workspaceMode": { "type": "string", "enum": ["existing", "new_per_run"] },
            "workspaceId": { "description": "Workspace ID string or null." }, "baseBranch": { "description": "Base branch string or null." },
            "setupDecision": { "type": "string", "enum": ["run", "skip"] }, "reuseSession": { "type": "boolean" },
            "runContext": { "description": "Opaque object or null.", "additionalProperties": true },
            "sourceContext": { "description": "Opaque object or null.", "additionalProperties": true },
            "launchOverrides": { "description": "Structured launch overrides object or null.", "additionalProperties": true },
            "precheck": { "description": "Precheck object or null.", "additionalProperties": true },
            "timezone": { "type": "string" }, "rrule": { "type": "string" }, "dtstart": { "type": "integer" },
            "enabled": { "type": "boolean" }, "nextRunAt": { "type": "integer" },
            "missedRunPolicy": { "type": "string", "enum": ["run_once_within_grace"] },
            "missedRunGraceMinutes": { "type": "integer" }, "createdAt": { "type": "integer" }, "updatedAt": { "type": "integer" }
          },
          "required": ["id", "name", "prompt", "agentId", "projectId", "workspaceMode", "workspaceId", "baseBranch", "reuseSession", "runContext", "sourceContext", "launchOverrides", "precheck", "timezone", "rrule", "dtstart", "enabled", "nextRunAt", "missedRunPolicy", "missedRunGraceMinutes", "createdAt", "updatedAt"],
          "additionalProperties": true
        }
      },
      {
        "id": "cancelEditor",
        "description": "Discards the retained automation editor draft without changing a definition.",
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": { "type": "object", "description": "Updated daemon-owned automation UI state.", "additionalProperties": true }
      }
    ],
    "cli-command": [
      {
        "id": "editor-data",
        "words": "editor-data",
        "summary": "read automation editor catalogs",
        "methods": ["quirky.automations/editorData"]
      },
      {
        "id": "editor-open",
        "words": "editor-open",
        "summary": "open or prepare an automation editor draft",
        "flags": {
          "id": { "type": "string", "description": "existing automation ID" },
          "template": { "type": "string", "description": "template ID", "enum": ["repo-health-weekday", "release-prep-weekly", "recurring-review-daily", "maintenance-hourly"] }
        },
        "methods": ["quirky.automations/openEditor"]
      },
      {
        "id": "editor-patch",
        "words": "editor-patch",
        "summary": "apply a JSON automation draft patch",
        "flags": {
          "patch": { "type": "json", "description": "partial AutomationDraft object", "required": true },
          "template": { "type": "string", "description": "apply a template while preserving the selected target", "enum": ["repo-health-weekday", "release-prep-weekly", "recurring-review-daily", "maintenance-hourly"] }
        },
        "methods": ["quirky.automations/patchDraft"]
      },
      {
        "id": "editor-save",
        "words": "editor-save",
        "summary": "validate and save the current automation draft",
        "flags": {
          "trust-setup": { "type": "boolean", "description": "setup hook trust was explicitly confirmed at its inspected immutable revision" }
        },
        "methods": ["quirky.automations/saveEditor"]
      },
      {
        "id": "editor-cancel",
        "words": "editor-cancel",
        "summary": "discard the current automation editor draft",
        "methods": ["quirky.automations/cancelEditor"]
      }
    ]
  }
}
