{
  "id": "quirky.feedback",
  "apiVersion": "1.2.0",
  "name": "Feedback",
  "version": "0.1.0",
  "description": "Collects UI feedback comments written against captured on-screen context.",
  "activation": "lazy",
  "main": "main.ts",
  "contributes": {
    "method": [
      {"id":"list","description":"List feedback comments in insertion order; recovered is true when a corrupt comments file was set aside.","readOnly":true,"params":{"type":"object","properties":{},"additionalProperties":false},"result":{"type":"object","properties":{"comments":{"type":"array","items":{"type":"object","additionalProperties":true}},"recovered":{"type":"boolean"}},"required":["comments","recovered"],"additionalProperties":false}},
      {"id":"add","description":"Add a feedback comment with its captured context; fails with a feedback_full conflict at 50 comments.","params":{"type":"object","properties":{"intent":{"type":"string","enum":["change","question"]},"comment":{"type":"string"},"capture":{"type":"object","additionalProperties":true}},"required":["intent","comment","capture"],"additionalProperties":false},"result":{"type":"object","additionalProperties":true}},
      {"id":"update","description":"Change the text or intent of one comment; captured context never changes.","params":{"type":"object","properties":{"id":{"type":"string"},"comment":{"type":"string"},"intent":{"type":"string","enum":["change","question"]}},"required":["id"],"additionalProperties":false},"result":{"type":"object","additionalProperties":true}},
      {"id":"remove","description":"Remove one feedback comment.","params":{"type":"object","properties":{"id":{"type":"string"}},"required":["id"],"additionalProperties":false},"result":{"type":"object","properties":{"removed":{"type":"boolean"}},"required":["removed"],"additionalProperties":false}},
      {"id":"clear","description":"Remove every feedback comment.","params":{"type":"object","properties":{},"additionalProperties":false},"result":{"type":"object","properties":{"cleared":{"type":"number"}},"required":["cleared"],"additionalProperties":false}}
    ]
  }
}
