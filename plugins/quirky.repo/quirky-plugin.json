{
  "id": "quirky.repo",
  "name": "Repositories",
  "version": "0.1.0",
  "description": "Projects Quirky knows about: git repositories and plain folders, their groups, settings and hooks, and the selectors that name them.",
  "main": "main.ts",
  "cli": "cli.ts",
  "contributes": {
    "method": [
      {
        "id": "list",
        "description": "Every added project, ordered by when it was added.",
        "readOnly": true,
        "params": {
          "type": "object"
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string",
                "description": "The folder's basename."
              },
              "path": {
                "type": "string",
                "description": "Absolute path of the project's main working tree, or its folder."
              },
              "addedAt": {
                "type": "number"
              },
              "kind": {
                "type": "string",
                "description": "git or folder.",
                "enum": [
                  "git",
                  "folder"
                ]
              },
              "displayName": {
                "description": "User-chosen label shown in place of name; null when unset."
              },
              "groupId": {
                "description": "The group holding the project; null when ungrouped."
              }
            },
            "required": [
              "id",
              "name",
              "path",
              "addedAt",
              "kind"
            ]
          }
        }
      },
      {
        "id": "add",
        "description": "Adds the repository containing `path`, or with `folder` a plain directory as a folder project. Adding the same real path twice returns the existing project.",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "folder": {
              "type": "boolean",
              "description": "Add a directory that is not a git repository as a folder project."
            }
          },
          "required": [
            "path"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "description": "The folder's basename."
            },
            "path": {
              "type": "string",
              "description": "Absolute path of the project's main working tree, or its folder."
            },
            "addedAt": {
              "type": "number"
            },
            "kind": {
              "type": "string",
              "description": "git or folder.",
              "enum": [
                "git",
                "folder"
              ]
            },
            "displayName": {
              "description": "User-chosen label shown in place of name; null when unset."
            },
            "groupId": {
              "description": "The group holding the project; null when ungrouped."
            }
          },
          "required": [
            "id",
            "name",
            "path",
            "addedAt",
            "kind"
          ]
        }
      },
      {
        "id": "clone",
        "description": "Clones `url` into `<location or the worktrees folder>/<name or the repository's name>` and adds it. Fails when the destination exists.",
        "params": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "Anything `git clone` accepts."
            },
            "location": {
              "type": "string",
              "description": "Folder to clone into; defaults to the worktrees folder."
            },
            "name": {
              "type": "string",
              "description": "Folder name; defaults to the URL's last segment without .git."
            }
          },
          "required": [
            "url"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "description": "The folder's basename."
            },
            "path": {
              "type": "string",
              "description": "Absolute path of the project's main working tree, or its folder."
            },
            "addedAt": {
              "type": "number"
            },
            "kind": {
              "type": "string",
              "description": "git or folder.",
              "enum": [
                "git",
                "folder"
              ]
            },
            "displayName": {
              "description": "User-chosen label shown in place of name; null when unset."
            },
            "groupId": {
              "description": "The group holding the project; null when ungrouped."
            }
          },
          "required": [
            "id",
            "name",
            "path",
            "addedAt",
            "kind"
          ]
        }
      },
      {
        "id": "create",
        "description": "Creates `<location or the worktrees folder>/<name>`, runs `git init` in it and adds it.",
        "params": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "location": {
              "type": "string",
              "description": "Folder to create it in; defaults to the worktrees folder."
            }
          },
          "required": [
            "name"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "description": "The folder's basename."
            },
            "path": {
              "type": "string",
              "description": "Absolute path of the project's main working tree, or its folder."
            },
            "addedAt": {
              "type": "number"
            },
            "kind": {
              "type": "string",
              "description": "git or folder.",
              "enum": [
                "git",
                "folder"
              ]
            },
            "displayName": {
              "description": "User-chosen label shown in place of name; null when unset."
            },
            "groupId": {
              "description": "The group holding the project; null when ungrouped."
            }
          },
          "required": [
            "id",
            "name",
            "path",
            "addedAt",
            "kind"
          ]
        }
      },
      {
        "id": "scan",
        "description": "Finds the git repositories under `path`; hidden and dependency folders are skipped and a found repository is not searched.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "maxDepth": {
              "type": "integer",
              "description": "How many folders deep to look (default 3).",
              "minimum": 1,
              "maximum": 8
            },
            "maxRepos": {
              "type": "integer",
              "description": "Stop after this many repositories (default 100).",
              "minimum": 1,
              "maximum": 500
            }
          },
          "required": [
            "path"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "repos": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "name"
                ]
              }
            },
            "truncated": {
              "type": "boolean",
              "description": "True when more repositories were left."
            }
          },
          "required": [
            "repos",
            "truncated"
          ]
        }
      },
      {
        "id": "import",
        "description": "Adds every repository found under `path` that is not known yet and, with `group`, puts them all in that group (created with `path` as its parent folder when new).",
        "params": {
          "type": "object",
          "properties": {
            "path": {
              "type": "string"
            },
            "group": {
              "type": "string",
              "description": "Group name to hold the repositories."
            },
            "maxDepth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8
            },
            "maxRepos": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          "required": [
            "path"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "imported",
                      "already-known",
                      "failed"
                    ]
                  },
                  "repoId": {
                    "type": "string"
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "status"
                ]
              }
            },
            "imported": {
              "type": "integer"
            },
            "alreadyKnown": {
              "type": "integer"
            },
            "failed": {
              "type": "integer"
            },
            "groupId": {
              "type": "string"
            }
          },
          "required": [
            "results",
            "imported",
            "alreadyKnown",
            "failed"
          ]
        }
      },
      {
        "id": "remove",
        "description": "Closes the project's sessions, then forgets the project, its settings and its group membership. Nothing on disk is deleted.",
        "params": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "description": "A repo selector: id:, name: or path:, or a bare ID or name."
            }
          },
          "required": [
            "repo"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            }
          },
          "required": [
            "ok"
          ]
        }
      },
      {
        "id": "resolve",
        "description": "The project a selector names: id:, name: or path:, or a bare ID or name. name: also matches the display name.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "selector": {
              "type": "string"
            }
          },
          "required": [
            "selector"
          ]
        },
        "result": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string",
