          "required": [
            "id",
            "name",
            "path",
            "addedAt",
            "kind"
          ]
        }
      },
      {
        "id": "show",
        "description": "A project with its settings and effective hooks (the shared file at HEAD merged with the local scripts).",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "string",
              "description": "A repo selector: id:, name: or path:, or a bare ID or name."
