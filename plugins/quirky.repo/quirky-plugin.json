        "result": {
          "type": "object",
          "properties": {
            "repo": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "description": "The folder's basename."
                },
                "path": {
                  "type": "string",
                  "description": "Absolute path of the project's main working tree, or its folder."
                },
                "addedAt": {
                  "type": "number"
                },
                "kind": {
                  "type": "string",
                  "description": "git or folder.",
                  "enum": [
                    "git",
                    "folder"
                  ]
                },
                "displayName": {
                  "description": "User-chosen label shown in place of name; null when unset."
                },
                "groupId": {
                  "description": "The group holding the project; null when ungrouped."
                }
              },
              "required": [
                "id",
                "name",
                "path",
                "addedAt",
                "kind"
              ]
            },
            "settings": {
              "type": "object",
              "properties": {
                "defaultBase": {
                  "description": "Ref new branches are cut from; null when unset."
                },
                "worktreeLocation": {
                  "description": "Folder new worktrees go in; null for the global default."
                },
                "setupPolicy": {
                  "type": "string",
                  "enum": [
                    "ask",
                    "run-by-default",
                    "skip-by-default"
                  ]
                },
                "agentStartup": {
                  "description": "start-immediately or wait-for-setup; null when unset."
                },
                "commandSource": {
                  "description": "shared-only, local-only or run-both; null when unset."
                },
                "setupScript": {
                  "type": "string",
                  "description": "The local setup script."
                },
                "archiveScript": {
                  "type": "string",
                  "description": "The local archive script."
                }
              },
              "required": [
                "setupPolicy",
                "setupScript",
                "archiveScript"
              ]
            },
            "hooks": {
              "type": "object",
              "properties": {
                "file": {
                  "description": "quirky.yaml or orca.yaml; null when neither exists at the ref."
                },
                "setup": {
                  "description": "The effective setup script as { text, source, badge, shared }, or null."
                },
                "archive": {
                  "description": "The effective archive script as { text, source, badge, shared }, or null."
                },
                "agentStartup": {
                  "type": "string",
