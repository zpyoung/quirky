                  }
                },
                "warnings": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "agentStartup",
                "sharedDirectories",
                "warnings"
              ]
            }
          },
          "required": [
            "repo",
            "settings",
            "hooks"
          ]
        }
      },
