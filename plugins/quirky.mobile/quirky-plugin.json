{
  "id": "quirky.mobile",
  "name": "Mobile",
  "version": "0.1.0",
  "description": "Pair phones with Quirky over a direct encrypted connection.",
  "main": "main.ts",
  "ui": "dist/ui.js",
  "cli": "cli.ts",
  "activation": "startup",
  "contributes": {
    "method": [
      {
        "id": "notificationPoll",
        "description": "Read or long-poll the bounded notification-only replay for an authenticated phone; never exposes general daemon events.",
        "connection": true,
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "after": { "type": "integer", "minimum": 0 },
            "epoch": { "type": "string" },
            "waitMs": { "type": "integer", "minimum": 0, "maximum": 25000 },
            "onlyWhenDesktopAway": { "type": "boolean" },
            "suppressWorktree": { "type": "string" },
            "subscriptionId": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      {
        "id": "notificationCancel",
        "description": "Cancel only this caller's pending phone notification poll, optionally matching the subscription generation.",
        "connection": true,
        "params": { "type": "object", "properties": { "subscriptionId": { "type": "string" } }, "additionalProperties": false }
      },
      {
        "id": "notificationTest",
        "description": "Send a test alert to direct phone subscriptions without a native desktop banner or cloud service.",
        "params": { "type": "object", "properties": {}, "additionalProperties": false }
      },
      {
        "id": "info",
        "description": "Read the configured desktop name and platform from a paired phone.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "machineName": { "type": "string" },
            "platform": { "type": "string" },
            "deviceScope": { "type": "string", "enum": ["mobile"] }
          },
          "required": ["machineName", "platform", "deviceScope"],
          "additionalProperties": false
        }
      },
      {
        "id": "state",
        "description": "Read the non-secret mobile pairing and listener state.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "machineName": { "type": "string" },
            "showMobileButton": { "type": "boolean" },
            "onboardingSeen": { "type": "boolean" },
            "autoRestoreFitMs": {},
            "customAddresses": { "type": "array", "items": { "type": "string" } },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "address": { "type": "string" },
                  "family": { "type": "string", "enum": ["IPv4", "IPv6"] },
                  "kind": { "type": "string", "enum": ["tailscale", "lan", "virtual"] }
                },
                "required": ["name", "address", "family", "kind"],
                "additionalProperties": false
              }
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "deviceId": { "type": "string" },
                  "name": { "type": "string" },
                  "pairedAt": { "type": "number" },
                  "lastSeenAt": { "type": "number" }
                },
                "required": ["deviceId", "name", "pairedAt", "lastSeenAt"],
                "additionalProperties": false
              }
            },
            "listener": {
              "type": "object",
              "properties": {
                "available": { "type": "boolean" },
                "host": {},
                "port": {}
              },
              "required": ["available", "host", "port"],
              "additionalProperties": false
            },
            "relay": { "type": "string", "enum": ["unavailable"] }
          },
          "required": ["machineName", "showMobileButton", "onboardingSeen", "autoRestoreFitMs", "customAddresses", "interfaces", "devices", "listener", "relay"],
          "additionalProperties": false
        }
      },
      {
        "id": "interfaces",
        "description": "List the current ranked and usable network interfaces.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "address": { "type": "string" },
              "family": { "type": "string", "enum": ["IPv4", "IPv6"] },
              "kind": { "type": "string", "enum": ["tailscale", "lan", "virtual"] }
            },
            "required": ["name", "address", "family", "kind"],
            "additionalProperties": false
          }
        }
      },
      {
        "id": "pair",
        "description": "Create or reuse a pending direct mobile pairing offer.",
        "params": {
          "type": "object",
          "properties": {
            "address": { "type": "string" },
            "rotate": { "type": "boolean" }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "pairingUrl": { "type": "string" },
            "endpoint": { "type": "string" },
            "deviceId": { "type": "string" },
            "connectionMode": { "type": "string", "enum": ["local-only"] },
            "qrDataUrl": {},
            "qrSize": {},
            "qrError": { "type": "string", "enum": ["encoding_failed"] },
            "reason": { "type": "string", "enum": ["invalid_advertised_endpoint", "network_exposure_failed", "device_registry_unavailable", "e2ee_key_unavailable", "websocket_unavailable"] },
            "guidance": { "type": "string" }
          },
          "required": ["available"],
          "additionalProperties": false
        }
      },
      {
        "id": "devices",
        "description": "List durably paired mobile devices; pending offers are excluded.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceId": { "type": "string" },
              "name": { "type": "string" },
              "pairedAt": { "type": "number" },
              "lastSeenAt": { "type": "number" }
            },
            "required": ["deviceId", "name", "pairedAt", "lastSeenAt"],
            "additionalProperties": false
          }
        }
      },
      {
        "id": "revoke",
        "description": "Durably revoke a paired mobile device and close all its connections.",
        "params": {
          "type": "object",
          "properties": { "deviceId": { "type": "string" } },
          "required": ["deviceId"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": { "revoked": { "type": "boolean" } },
          "required": ["revoked"],
          "additionalProperties": false
        }
      },
      {
        "id": "configure",
        "description": "Persist mobile display, address, and terminal-fit preferences.",
        "params": {
          "type": "object",
          "properties": {
            "machineName": { "type": "string" },
            "showMobileButton": { "type": "boolean" },
            "onboardingSeen": { "type": "boolean" },
            "autoRestoreFitMs": {},
            "customAddresses": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": {
            "machineName": { "type": "string" },
            "showMobileButton": { "type": "boolean" },
            "onboardingSeen": { "type": "boolean" },
            "autoRestoreFitMs": {},
            "customAddresses": { "type": "array", "items": { "type": "string" } },
            "interfaces": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": { "type": "string" },
                  "address": { "type": "string" },
                  "family": { "type": "string", "enum": ["IPv4", "IPv6"] },
                  "kind": { "type": "string", "enum": ["tailscale", "lan", "virtual"] }
                },
                "required": ["name", "address", "family", "kind"],
                "additionalProperties": false
              }
            },
            "devices": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "deviceId": { "type": "string" },
                  "name": { "type": "string" },
                  "pairedAt": { "type": "number" },
                  "lastSeenAt": { "type": "number" }
                },
                "required": ["deviceId", "name", "pairedAt", "lastSeenAt"],
                "additionalProperties": false
              }
            },
            "listener": {
              "type": "object",
              "properties": {
                "available": { "type": "boolean" },
                "host": {},
                "port": {}
              },
              "required": ["available", "host", "port"],
              "additionalProperties": false
            },
            "relay": { "type": "string", "enum": ["unavailable"] }
          },
          "required": ["machineName", "showMobileButton", "onboardingSeen", "autoRestoreFitMs", "customAddresses", "interfaces", "devices", "listener", "relay"],
          "additionalProperties": false
        }
      },
      {
        "id": "preferences",
        "description": "Read the phone-owned auto-restore delay without exposing desktop mobile settings.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": { "autoRestoreFitMs": {} },
          "required": ["autoRestoreFitMs"],
          "additionalProperties": false
        }
      },
      {
        "id": "updatePreferences",
        "description": "Update only the phone's auto-restore delay.",
        "params": {
          "type": "object",
          "properties": { "autoRestoreFitMs": {} },
          "required": ["autoRestoreFitMs"],
          "additionalProperties": false
        },
        "result": {
          "type": "object",
          "properties": { "autoRestoreFitMs": {} },
          "required": ["autoRestoreFitMs"],
          "additionalProperties": false
        }
      },
      {
        "id": "agentCatalog",
        "description": "Read safe launcher labels and availability without exposing configured commands or credentials.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "defaultAgent": { "description": "The configured default launcher ID, or null; runtime type is string|null." },
            "agents": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string" },
                  "label": { "type": "string" },
                  "installed": { "type": "boolean" },
                  "enabled": { "type": "boolean" },
                  "isDefault": { "type": "boolean" },
                  "resumable": { "type": "boolean" }
                },
                "required": ["id", "label", "installed", "enabled", "isDefault", "resumable"],
                "additionalProperties": false
              }
            }
          },
          "required": ["defaultAgent", "agents"],
          "additionalProperties": false
        }
      },
      {
        "id": "sessionTabs",
        "description": "List safe nonterminal tabs using their actual workspace UI identities.",
        "readOnly": true,
        "params": { "type": "object", "properties": { "worktree": { "type": "string" } }, "required": ["worktree"], "additionalProperties": false },
        "result": { "type": "array", "items": { "type": "object", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "kind": { "type": "string", "enum": ["markdown", "browser"] },
          "browserMode": { "type": "string", "enum": ["native", "watch"] },
          "title": { "type": "string" }, "dirty": { "type": "boolean" }
        }, "required": ["tabId", "worktreeId", "kind", "title", "dirty"], "additionalProperties": false } }
      },
      {
        "id": "markdownCreate",
        "description": "Create a real Markdown document and workspace tab.",
        "params": { "type": "object", "properties": { "worktree": { "type": "string" } }, "required": ["worktree"], "additionalProperties": false },
        "result": { "type": "object", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "title": { "type": "string" }, "relativePath": { "type": "string" }, "text": { "type": "string" },
          "revision": { "type": "integer", "minimum": 0 }, "dirty": { "type": "boolean" }, "readOnly": { "type": "boolean" }
        }, "required": ["tabId", "worktreeId", "title", "relativePath", "text", "revision", "dirty", "readOnly"], "additionalProperties": false }
      },
      {
        "id": "markdownRead",
        "description": "Read bounded Markdown text from an exact workspace tab.",
        "readOnly": true,
        "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "tabId": { "type": "string" } }, "required": ["worktree", "tabId"], "additionalProperties": false },
        "result": { "type": "object", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "title": { "type": "string" }, "relativePath": { "type": "string" }, "text": { "type": "string" },
          "revision": { "type": "integer", "minimum": 0 }, "dirty": { "type": "boolean" }, "readOnly": { "type": "boolean" }
        }, "required": ["tabId", "worktreeId", "title", "relativePath", "text", "revision", "dirty", "readOnly"], "additionalProperties": false }
      },
      {
        "id": "markdownWrite",
        "description": "Update a bounded Markdown draft with an optimistic revision guard.",
        "params": { "type": "object", "properties": {
          "worktree": { "type": "string" }, "tabId": { "type": "string" }, "text": { "type": "string" }, "expectedRevision": { "type": "integer", "minimum": 0 }
        }, "required": ["worktree", "tabId", "text", "expectedRevision"], "additionalProperties": false },
        "result": { "type": "object", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "title": { "type": "string" }, "relativePath": { "type": "string" }, "text": { "type": "string" },
          "revision": { "type": "integer", "minimum": 0 }, "dirty": { "type": "boolean" }, "readOnly": { "type": "boolean" }
        }, "required": ["tabId", "worktreeId", "title", "relativePath", "text", "revision", "dirty", "readOnly"], "additionalProperties": false }
      },
      {
        "id": "markdownSave",
        "description": "Save the exact current Markdown draft without overwriting a newer revision.",
        "params": { "type": "object", "properties": {
          "worktree": { "type": "string" }, "tabId": { "type": "string" }, "expectedRevision": { "type": "integer", "minimum": 0 }
        }, "required": ["worktree", "tabId", "expectedRevision"], "additionalProperties": false },
        "result": { "type": "object", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "title": { "type": "string" }, "relativePath": { "type": "string" }, "text": { "type": "string" },
          "revision": { "type": "integer", "minimum": 0 }, "dirty": { "type": "boolean" }, "readOnly": { "type": "boolean" }
        }, "required": ["tabId", "worktreeId", "title", "relativePath", "text", "revision", "dirty", "readOnly"], "additionalProperties": false }
      },
      {
        "id": "sessionTabAction",
        "description": "Rename, refresh or explicitly close a workspace Markdown tab.",
        "params": { "type": "object", "properties": {
          "worktree": { "type": "string" }, "tabId": { "type": "string" },
          "action": { "type": "string", "enum": ["rename", "refresh", "close"] }, "name": { "type": "string" }, "discard": { "type": "boolean" }
        }, "required": ["worktree", "tabId", "action"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "tabId": { "type": "string" }, "closed": { "type": "boolean" } }, "required": ["tabId", "closed"], "additionalProperties": false }
      },
      {
        "id": "browserWatchCreate", "connection": true,
        "description": "Explicitly create a Chrome Watch tab; never converts a Native browser silently.",
        "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "url": { "type": "string" } }, "required": ["worktree"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "watchId": { "type": "string" }, "tab": { "type": "object", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "kind": { "type": "string", "enum": ["browser"] }, "title": { "type": "string" }, "dirty": { "type": "boolean" }, "browserMode": { "type": "string", "enum": ["native", "watch"] }
        }, "required": ["tabId", "worktreeId", "kind", "title", "dirty"], "additionalProperties": false } }, "required": ["tab", "watchId"], "additionalProperties": false }
      },
      {
        "id": "browserWatchStart", "connection": true,
        "description": "Start an exclusive connection-owned lease on an existing Watch tab; rejects Native tabs.",
        "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "tabId": { "type": "string" } }, "required": ["worktree", "tabId"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "watchId": { "type": "string" }, "tab": { "type": "object", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "kind": { "type": "string", "enum": ["browser"] }, "title": { "type": "string" }, "dirty": { "type": "boolean" }, "browserMode": { "type": "string", "enum": ["native", "watch"] }
        }, "required": ["tabId", "worktreeId", "kind", "title", "dirty"], "additionalProperties": false } }, "required": ["tab", "watchId"], "additionalProperties": false }
      },
      {
        "id": "browserWatchFrame", "connection": true, "readOnly": true,
        "description": "Read the latest bounded JPEG for the exact connection/tab/Watch lease; no generic event access.",
        "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "tabId": { "type": "string" }, "watchId": { "type": "string" } }, "required": ["worktree", "tabId", "watchId"], "additionalProperties": false },
        "result": { "description": "MobileBrowserFrame or null before a frame arrives; producer permits only those two shapes.", "properties": {
          "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "watchId": { "type": "string" }, "sequence": { "type": "integer", "minimum": 1 },
          "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "mimeType": { "type": "string", "enum": ["image/jpeg"] }, "data": { "type": "string", "description": "Base64 JPEG, at most 512 KiB of encoded text." }
        }, "required": ["tabId", "worktreeId", "watchId", "sequence", "width", "height", "mimeType", "data"], "additionalProperties": false }
      },
      {
        "id": "browserWatchFrameAck", "connection": true,
        "description": "Acknowledge only the exact current frame after the phone image has loaded.",
        "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "tabId": { "type": "string" }, "watchId": { "type": "string" }, "sequence": { "type": "integer", "minimum": 1 } }, "required": ["worktree", "tabId", "watchId", "sequence"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "acknowledged": { "type": "boolean" } }, "required": ["acknowledged"], "additionalProperties": false }
      },
      {
        "id": "browserWatchStop", "connection": true,
        "description": "Release an exact owned Watch lease without closing its page or another consumer.",
        "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "tabId": { "type": "string" }, "watchId": { "type": "string" } }, "required": ["worktree", "tabId", "watchId"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "closed": { "type": "boolean" } }, "required": ["closed"], "additionalProperties": false }
      },
      {
        "id": "browserWatchNavigate", "connection": true,
        "description": "Navigate the exact owned Watch tab using the Browser plugin's address normalization.",
        "params": { "type": "object", "properties": { "worktree": { "type": "string" }, "tabId": { "type": "string" }, "watchId": { "type": "string" }, "input": { "type": "string" } }, "required": ["worktree", "tabId", "watchId", "input"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "kind": { "type": "string", "enum": ["browser"] }, "title": { "type": "string" }, "dirty": { "type": "boolean" }, "browserMode": { "type": "string", "enum": ["native", "watch"] } }, "required": ["tabId", "worktreeId", "kind", "title", "dirty"], "additionalProperties": false }
      },
      {
        "id": "browserWatchControl", "connection": true,
        "description": "Apply one closed typed navigation, find, zoom or viewport control to an owned Watch tab.",
        "params": { "type": "object", "properties": {
          "worktree": { "type": "string" }, "tabId": { "type": "string" }, "watchId": { "type": "string" },
          "action": { "type": "string", "enum": ["back", "forward", "reload", "stop", "find", "zoom", "viewport"] },
          "text": { "type": "string" }, "forward": { "type": "boolean" }, "level": { "type": "number", "minimum": -3, "maximum": 5 },
          "preset": { "type": "string", "enum": ["default", "mobile-s", "mobile-m", "mobile-l", "tablet", "laptop", "laptop-l", "desktop"] }
        }, "required": ["worktree", "tabId", "watchId", "action"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "tabId": { "type": "string" }, "worktreeId": { "type": "string" }, "kind": { "type": "string", "enum": ["browser"] }, "title": { "type": "string" }, "dirty": { "type": "boolean" }, "browserMode": { "type": "string", "enum": ["native", "watch"] } }, "required": ["tabId", "worktreeId", "kind", "title", "dirty"], "additionalProperties": false }
      },
      {
        "id": "browserWatchInput", "connection": true,
        "description": "Send bounded typed pointer, key, text or wheel input to an owned Watch tab; never eval/CDP.",
        "params": { "type": "object", "properties": {
          "worktree": { "type": "string" }, "tabId": { "type": "string" }, "watchId": { "type": "string" }, "kind": { "type": "string", "enum": ["mouse", "key", "text", "wheel"] },
          "type": { "type": "string" }, "x": { "type": "number", "minimum": 0, "maximum": 16384 }, "y": { "type": "number", "minimum": 0, "maximum": 16384 },
          "button": { "type": "string" }, "key": { "type": "string" }, "code": { "type": "string" }, "text": { "type": "string" }, "deltaX": { "type": "number" }, "deltaY": { "type": "number" },
          "modifiers": { "type": "integer", "minimum": 0, "maximum": 15 }
        }, "required": ["worktree", "tabId", "watchId", "kind"], "additionalProperties": false },
        "result": { "type": "object", "properties": { "sent": { "type": "boolean" } }, "required": ["sent"], "additionalProperties": false }
      },
      {
        "id": "bundleManifest",
        "description": "Read the packaged, immutable Quirky mobile page bundle manifest.",
        "readOnly": true,
        "params": { "type": "object", "properties": {}, "additionalProperties": false },
        "result": {
          "type": "object",
          "properties": {
            "manifest": {
              "type": "object",
              "properties": {
                "v": { "type": "integer", "enum": [1] },
                "shellVersion": { "type": "integer", "enum": [1] },
                "buildId": { "type": "string" },
                "assets": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "path": { "type": "string" },
                      "bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
                      "sha256": { "type": "string" },
                      "contentType": { "type": "string" }
                    },
                    "required": ["path", "bytes", "sha256", "contentType"],
                    "additionalProperties": false
                  }
                },
                "totalBytes": { "type": "integer", "minimum": 1, "maximum": 33554432 },
                "routes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "kind": { "type": "string", "enum": ["workspaces", "session"] },
                      "path": { "type": "string" },
                      "grants": {
                        "type": "array",
                        "items": { "type": "string", "enum": ["rpc", "terminal", "storage", "navigate", "clipboard.read", "clipboard.write", "externalLink", "haptics"] }
                      }
                    },
                    "required": ["kind", "path", "grants"],
                    "additionalProperties": false
                  }
                }
              },
              "required": ["v", "shellVersion", "buildId", "assets", "totalBytes", "routes"],
              "additionalProperties": false
            },
            "chunkBytes": { "type": "integer", "minimum": 1, "maximum": 262144 },
            "rangeBytes": { "type": "integer", "minimum": 1, "maximum": 131072 }
          },
          "required": ["manifest", "chunkBytes", "rangeBytes"],
          "additionalProperties": false
        }
      },
      {
        "id": "bundleChunk",
        "description": "Read one bounded identity-encoded page-bundle chunk by manifest path.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "buildId": { "type": "string" },
            "path": { "type": "string" },
