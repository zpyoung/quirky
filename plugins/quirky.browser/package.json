{
  "name": "@quirky/plugin-browser",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@quirky/protocol": "workspace:*",
    "agent-browser": "0.27.0",
    "pngjs": "7.0.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tldts": "7.4.16"
  },
  "devDependencies": {
    "@quirky/git": "workspace:*",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@happy-dom/global-registrator": "20.14.6"
  },
  "quirky": {
    "assets": [
      {
        "dependency": "agent-browser",
        "source": "bin/agent-browser-{platform}-{arch}",
        "destination": "bin/agent-browser",
        "executable": true
      },
      {
        "dependency": "agent-browser",
        "source": "LICENSE",
        "destination": "licenses/agent-browser-LICENSE"
      },
      {
        "dependency": "pngjs",
        "source": "LICENSE",
        "destination": "licenses/pngjs-LICENSE"
      },
      {
        "dependency": "tldts",
        "source": "LICENSE",
        "destination": "licenses/tldts.LICENSE"
      }
    ]
  }
}
