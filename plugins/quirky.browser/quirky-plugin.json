{
  "id": "quirky.browser",
  "name": "Browser",
  "version": "0.1.0",
  "description": "Owned headless Chromium automation and isolated browser profiles.",
  "activation": "lazy",
  "main": "main.ts",
  "cli": "cli.ts",
  "dependencies": ["quirky.worktree"],
  "contributes": {
    "method": [
      {"id":"preferencesState","description":"Read profile usage, identity restart status and real import/routing capabilities without starting a browser.","readOnly":true,"params":{"type":"object","properties":{},"additionalProperties":false},"result":{"type":"object","properties":{"profiles":{"type":"array","items":{"type":"object","additionalProperties":true}},"identity":{"type":"object","additionalProperties":true},"imports":{"type":"object","additionalProperties":true},"localhostLabels":{"type":"object","additionalProperties":true}},"required":["profiles","identity","imports","localhostLabels"],"additionalProperties":false}},
      {"id":"profileSet","description":"Switch one Browser pane profile, preserving its hosted tab and URL.","params":{"type":"object","properties":{"pane":{"type":"string"},"profile":{"type":"string"}},"required":["pane","profile"],"additionalProperties":false},"result":{"type":"object","properties":{"pane":{"type":"object","additionalProperties":true}},"required":["pane"],"additionalProperties":false}},
      {"id":"profileClear","description":"Clear an unused profile's native and owned Chrome site data, retaining the profile.","destructive":true,"confirm":"Clear this Browser profile's cookies and site data?","params":{"type":"object","properties":{"profile":{"type":"string"}},"required":["profile"],"additionalProperties":false},"result":{"type":"object","properties":{"cleared":{"type":"boolean"}},"required":["cleared"],"additionalProperties":false}},
      {"id":"profileDelete","description":"Remove an unused isolated Browser profile and its native and owned Chrome site data.","destructive":true,"confirm":"Remove this Browser profile and all its cookies and site data?","params":{"type":"object","properties":{"profile":{"type":"string"}},"required":["profile"],"additionalProperties":false},"result":{"type":"object","properties":{"deleted":{"type":"boolean"}},"required":["deleted"],"additionalProperties":false}},
      {"id":"profileClearNativeClaim","description":"Consume a one-use pending confirmed native profile clear capability.","params":{"type":"object","properties":{"request":{"type":"string"}},"required":["request"],"additionalProperties":false},"result":{"type":"object","properties":{"partition":{"type":"string"}},"required":["partition"],"additionalProperties":false}},
      {"id":"openLink","description":"Open a worktree HTTP(S) link using Browser routing and one-click modifier policy.","params":{"type":"object","properties":{"url":{"type":"string"},"worktree":{"type":"string"},"shift":{"type":"boolean"},"modifier":{"type":"boolean"}},"required":["url","worktree"],"additionalProperties":false},"result":{"type":"object","properties":{"route":{"type":"string","enum":["app","external"]},"pane":{"type":"string"}},"required":["route"],"additionalProperties":false}},
      {"id":"tabList","description":"List managed browser pages without starting Chrome.","readOnly":true,"params":{"type":"object","properties":{"worktree":{"type":"string"},"cwd":{"type":"string"}},"additionalProperties":false},"result":{"type":"object","properties":{"tabs":{"type":"array","items":{"type":"object","properties":{"browserPageId":{"type":"string"},"worktreeId":{},"profileId":{"type":"string"},"index":{"type":"integer"},"active":{"type":"boolean"},"url":{"type":"string"},"title":{"type":"string"},"loadError":{}},"required":["browserPageId","worktreeId","profileId","index","active","url","title","loadError"],"additionalProperties":false}}},"required":["tabs"],"additionalProperties":false}},
      {"id":"tabShow","description":"Show one managed page from persisted metadata without starting Chrome.","readOnly":true,"params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"}},"required":["page"],"additionalProperties":false},"result":{"type":"object","properties":{"tab":{"type":"object","properties":{"browserPageId":{"type":"string"},"worktreeId":{},"profileId":{"type":"string"},"index":{"type":"integer"},"active":{"type":"boolean"},"url":{"type":"string"},"title":{"type":"string"},"loadError":{}},"required":["browserPageId","worktreeId","profileId","index","active","url","title","loadError"],"additionalProperties":false}},"required":["tab"],"additionalProperties":false}},
      {"id":"tabCurrent","description":"Return the active managed page for a worktree or the unique global active page.","readOnly":true,"params":{"type":"object","properties":{"worktree":{"type":"string"},"cwd":{"type":"string"}},"additionalProperties":false},"result":{"type":"object","properties":{"tab":{"type":"object","properties":{"browserPageId":{"type":"string"},"worktreeId":{},"profileId":{"type":"string"},"index":{"type":"integer"},"active":{"type":"boolean"},"url":{"type":"string"},"title":{"type":"string"},"loadError":{}},"required":["browserPageId","worktreeId","profileId","index","active","url","title","loadError"],"additionalProperties":false}},"required":["tab"],"additionalProperties":false}},
      {"id":"tabCreate","description":"Create a new managed page in the owned headless browser.","params":{"type":"object","properties":{"url":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"},"profile":{"type":"string"}},"additionalProperties":false},"result":{"type":"object","properties":{"browserPageId":{"type":"string"}},"required":["browserPageId"],"additionalProperties":false}},
      {"id":"tabSwitch","description":"Switch the active managed page without focusing a native window.","params":{"type":"object","properties":{"page":{"type":"string"},"index":{"type":"integer"},"worktree":{"type":"string"},"cwd":{"type":"string"},"focus":{"type":"boolean"}},"additionalProperties":false},"result":{"type":"object","properties":{"switched":{"type":"integer"},"browserPageId":{"type":"string"}},"required":["switched","browserPageId"],"additionalProperties":false}},
      {"id":"tabClose","description":"Close a managed page and cancel its queued and in-flight work.","destructive":true,"confirm":"Close this managed browser page?","params":{"type":"object","properties":{"page":{"type":"string"},"index":{"type":"integer"},"worktree":{"type":"string"},"cwd":{"type":"string"}},"additionalProperties":false},"result":{"type":"object","properties":{"closed":{"type":"boolean"}},"required":["closed"],"additionalProperties":false}},
      {"id":"snapshot","description":"Read an accessibility snapshot and mint generation-bound public references.","readOnly":true,"params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"}},"additionalProperties":false},"result":{"type":"object","properties":{"browserPageId":{"type":"string"},"projectionId":{"type":"string"},"url":{"type":"string"},"title":{"type":"string"},"snapshot":{"type":"string"},"refs":{"type":"array","items":{"type":"object","properties":{"ref":{"type":"string"},"role":{"type":"string"},"name":{"type":"string"}},"required":["ref","role","name"],"additionalProperties":false}}},"required":["browserPageId","projectionId","url","title","snapshot","refs"],"additionalProperties":false}},
      {"id":"screenshot","description":"Capture the current viewport as PNG or JPEG.","readOnly":true,"params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"},"format":{"type":"string","enum":["png","jpeg"]}},"additionalProperties":false},"result":{"type":"object","properties":{"data":{"type":"string"},"format":{"type":"string","enum":["png","jpeg"]}},"required":["data","format"],"additionalProperties":false}},
      {"id":"goto","description":"Navigate to an absolute HTTP, HTTPS, file, or about:blank URL.","params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"},"url":{"type":"string"}},"required":["url"],"additionalProperties":false},"result":{"type":"object","properties":{"url":{"type":"string"},"title":{"type":"string"}},"required":["url","title"],"additionalProperties":false}},
      {"id":"click","description":"Click a CSS selector or current public snapshot reference.","params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"},"element":{"type":"string"}},"required":["element"],"additionalProperties":false},"result":{"type":"object","properties":{"clicked":{"type":"string"}},"required":["clicked"],"additionalProperties":false}},
      {"id":"fill","description":"Replace the value of a scoped input while preserving exact text.","params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"},"element":{"type":"string"},"value":{"type":"string"}},"required":["element","value"],"additionalProperties":false},"result":{"type":"object","properties":{"filled":{"type":"string"}},"required":["filled"],"additionalProperties":false}},
      {"id":"eval","description":"Evaluate JavaScript in the scoped page and return only a serializable JSON value.","params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"},"expression":{"type":"string"}},"required":["expression"],"additionalProperties":false},"result":{"type":"object","properties":{"value":{}},"required":["value"],"additionalProperties":false}},
      {"id":"profileList","description":"List persisted isolated browser profiles without starting Chrome.","readOnly":true,"params":{"type":"object","properties":{},"additionalProperties":false},"result":{"type":"object","properties":{"profiles":{"type":"array","items":{"type":"object","properties":{"id":{"type":"string"},"label":{"type":"string"},"scope":{"type":"string","enum":["default","isolated"]}},"required":["id","label","scope"],"additionalProperties":false}}},"required":["profiles"],"additionalProperties":false}},
      {"id":"profileCreate","description":"Create a persistent isolated browser profile.","params":{"type":"object","properties":{"name":{"type":"string"}},"required":["name"],"additionalProperties":false},"result":{"type":"object","properties":{"profile":{"type":"object","properties":{"id":{"type":"string"},"label":{"type":"string"},"scope":{"type":"string","enum":["default","isolated"]}},"required":["id","label","scope"],"additionalProperties":false}},"required":["profile"],"additionalProperties":false}},
      {"id":"exec","description":"Run one quote-aware shell-free command from the closed owned browser command catalog.","params":{"type":"object","properties":{"page":{"type":"string"},"worktree":{"type":"string"},"cwd":{"type":"string"},"command":{"type":"string"}},"required":["command"],"additionalProperties":false},"result":{"type":"object","properties":{"command":{"type":"object"},"result":{}},"required":["command","result"],"additionalProperties":false}}
    ],
    "cli-command": [
      {"id":"preferencesState","words":"preferences","summary":"show Browser profiles, capabilities and identity restart status","methods":["quirky.browser/preferencesState"]},
      {"id":"profileSet","words":"tab profile set","summary":"switch one Browser pane profile","methods":["quirky.browser/profileSet"],"flags":{"pane":{"type":"string","description":"Browser pane ID","required":true},"profile":{"type":"string","description":"Browser profile ID","required":true}}},
      {"id":"profileClear","words":"tab profile clear","summary":"clear an unused Browser profile's cookies and site data","methods":["quirky.browser/profileClear"],"flags":{"profile":{"type":"string","description":"Browser profile ID","required":true}}},
      {"id":"profileDelete","words":"tab profile delete","summary":"remove an unused isolated Browser profile","methods":["quirky.browser/profileDelete"],"flags":{"profile":{"type":"string","description":"Browser profile ID","required":true}}},
      {"id":"openLink","words":"open-link","summary":"open a worktree link using Browser routing","methods":["quirky.browser/openLink"],"flags":{"url":{"type":"string","description":"absolute HTTP(S) URL","required":true},"worktree":{"type":"string","description":"originating worktree selector","required":true},"shift":{"type":"boolean","description":"Shift held for this click"},"modifier":{"type":"boolean","description":"Cmd/Ctrl held for this click"}}},
      {"id":"tabList","words":"tab list","summary":"list managed browser pages","methods":["quirky.browser/tabList","quirky.browser/profileList"],"flags":{"worktree":{"type":"string","description":"filter by worktree selector or all"}}},
      {"id":"tabShow","words":"tab show","summary":"show one managed page","methods":["quirky.browser/tabShow"],"flags":{"page":{"type":"string","description":"public browser page ID","required":true},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"tabCurrent","words":"tab current","summary":"show the active managed page","methods":["quirky.browser/tabCurrent"],"flags":{"worktree":{"type":"string","description":"worktree selector or all"}}},
      {"id":"tabCreate","words":"tab create","summary":"create a managed headless browser page","methods":["quirky.browser/tabCreate"],"flags":{"url":{"type":"string","description":"initial absolute page URL"},"worktree":{"type":"string","description":"worktree selector"},"profile":{"type":"string","description":"browser profile ID"}}},
      {"id":"tabSwitch","words":"tab switch","summary":"switch managed page without focusing a native window","methods":["quirky.browser/tabSwitch"],"flags":{"page":{"type":"string","description":"public page ID"},"index":{"type":"integer","description":"zero-based page index"},"worktree":{"type":"string","description":"worktree selector"},"focus":{"type":"boolean","description":"request visible focus (unsupported in headless mode)"}}},
      {"id":"tabClose","words":"tab close","summary":"close a managed browser page","methods":["quirky.browser/tabClose"],"flags":{"page":{"type":"string","description":"public page ID"},"index":{"type":"integer","description":"zero-based page index"},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"profileList","words":"tab profile list","summary":"list persisted browser profiles","methods":["quirky.browser/profileList"]},
      {"id":"profileCreate","words":"tab profile create","summary":"create an isolated browser profile","methods":["quirky.browser/profileCreate"],"flags":{"label":{"type":"string","description":"profile label","required":true}}},
      {"id":"snapshot","words":"snapshot","summary":"read accessibility snapshot and mint scoped references","methods":["quirky.browser/snapshot"],"flags":{"page":{"type":"string","description":"public page ID"},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"screenshot","words":"screenshot","summary":"capture current viewport as PNG or JPEG","methods":["quirky.browser/screenshot"],"flags":{"format":{"type":"string","description":"image format","enum":["png","jpeg"]},"page":{"type":"string","description":"public page ID"},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"goto","words":"goto","summary":"navigate to an absolute URL","methods":["quirky.browser/goto"],"flags":{"url":{"type":"string","description":"absolute HTTP, HTTPS, file, or about:blank URL","required":true},"page":{"type":"string","description":"public page ID"},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"click","words":"click","summary":"click a selector or current snapshot reference","methods":["quirky.browser/click"],"flags":{"element":{"type":"string","description":"CSS selector or qbr1 reference","required":true},"page":{"type":"string","description":"public page ID"},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"fill","words":"fill","summary":"replace an input value","methods":["quirky.browser/fill"],"flags":{"element":{"type":"string","description":"CSS selector or qbr1 reference","required":true},"value":{"type":"string","description":"text to fill","required":true},"page":{"type":"string","description":"public page ID"},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"eval","words":"eval","summary":"evaluate page JavaScript","methods":["quirky.browser/eval"],"flags":{"expression":{"type":"string","description":"JavaScript expression","required":true},"page":{"type":"string","description":"public page ID"},"worktree":{"type":"string","description":"worktree selector"}}},
      {"id":"exec","words":"exec","summary":"run a closed shell-free agent-browser command","methods":["quirky.browser/exec"],"flags":{"command":{"type":"string","description":"one quoted agent-browser command","required":true},"page":{"type":"string","description":"public page ID"},"worktree":{"type":"string","description":"worktree selector"}}}
    ],
    "setting": [
      {"id":"openLinksInApp","type":"boolean","title":"Link Routing","description":"Open HTTP(S) links from terminals, Markdown and editor in Quirky's Browser.","category":"Browser","section":"Link Routing","default":false},
      {"id":"openLinksInAppModifierInverts","type":"boolean","title":"Hold Shift to invert Link Routing","description":"Shift+Cmd-click inverts Link Routing once; otherwise Shift+Cmd-click always uses the system web browser.","category":"Browser","section":"Link Routing","default":false},
      {"id":"browserImportHintHidden","type":"boolean","title":"Hide Import browser data hint","category":"Browser","section":"Session & Cookies","default":false},
      {"id":"agentBrowserUseEnabled","type":"boolean","title":"Enable Agent Browser Use","description":"Show setup guidance only; this does not install a skill or gate Browser API commands.","category":"Browser","section":"Agent Browser Use","default":false},
      {"id":"identityMode","type":"enum","title":"Browser identity (Chrome)","description":"Cleaned removes embedding/headless user-agent tokens. Applies after daemon/plugin restart; native system-webview identity hook is unavailable.","category":"Browser","section":"Browser identity","values":["clean","native"],"default":"clean"}
    ],
    "settings-section": [{"id":"browser-preferences","title":"Browser: Session & Cookies","order":40}],
    "view": [{"id":"browser-settings","title":"Browser Settings"}],
    "command": [
      {"id":"browserSettings","title":"Browser Settings","args":{"type":"object","properties":{},"additionalProperties":false}},
      {"id":"profileClearNative","title":"Complete confirmed Browser profile clear","args":{"type":"object","properties":{"request":{"type":"string"}},"required":["request"],"additionalProperties":false}}
    ],
    "event": [{"id":"preferencesChanged","description":"Browser profile usage or preferences changed.","data":{"type":"object","properties":{},"additionalProperties":false}}]
  }
