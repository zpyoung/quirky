{
  "id": "quirky.session",
  "name": "Session (fake)",
  "version": "0.0.0",
  "main": "main.ts",
  "contributes": {
    "method": [
      { "id": "register", "params": { "type": "object", "additionalProperties": true } },
      {
        "id": "setProviderSession",
        "description": "Stores the agent CLI's own session ID (and transcript path) on a session so it can be resumed.",
        "params": {
          "type": "object",
          "properties": {
            "session": { "type": "string", "description": "The session ID." },
            "id": {
              "type": "string",
              "description": "The agent CLI's session ID: 1 to 512 characters, no leading `-`, no control characters."
            },
            "transcriptPath": { "type": "string", "description": "The transcript file, for agents that resume from one." }
          },
          "required": ["session", "id"]
        }
      },
      { "id": "setStatus", "params": { "type": "object", "additionalProperties": true } },
      {
        "id": "setProviderSession",
        "description": "Stores the agent CLI's own session ID (and transcript path) on a session so it can be resumed.",
        "params": {
          "type": "object",
          "properties": {
            "session": { "type": "string", "description": "The session ID." },
            "id": { "type": "string", "description": "The agent CLI's session ID: 1 to 512 characters, no leading `-`, no control characters." },
            "transcriptPath": { "type": "string", "description": "The transcript file, for agents that resume from one." }
          },
          "required": ["session", "id"]
        }
      },
      { "id": "get", "readOnly": true, "params": { "type": "object", "additionalProperties": true } },
      { "id": "list", "readOnly": true, "params": { "type": "object", "additionalProperties": true } },
      { "id": "close", "params": { "type": "object", "additionalProperties": true } },
      {
        "id": "identity",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": { "session": { "type": "string" } },
          "required": ["session"]
        },
        "result": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "live": { "type": "boolean" },
            "runtimeEpoch": { "type": "string" },
            "processIncarnation": { "type": "string" },
            "source": { "type": "string" },
            "kind": { "type": "string" },
            "providerId": { "description": "The provider ID, or null for a shell." },
            "worktreeId": { "type": "string" }
          },
          "required": ["sessionId", "live", "runtimeEpoch", "processIncarnation", "source", "kind", "providerId", "worktreeId"]
        }
      },
      {
        "id": "callerAuthority",
        "readOnly": true,
        "params": { "type": "object", "additionalProperties": true },
        "result": { "type": "object", "additionalProperties": true }
      }
    ],
    "event": [{ "id": "removed", "data": { "type": "object", "additionalProperties": true } }]
  }
}
