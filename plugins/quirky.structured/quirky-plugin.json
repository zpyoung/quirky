{
  "id": "quirky.structured",
  "name": "Structured sessions",
  "version": "0.1.0",
  "description": "Background native Claude and Codex sessions without terminals: journaled messages and permission prompts as asks.",
  "main": "main.ts",
  "activation": "lazy",
  "dependencies": ["quirky.session", "quirky.ask", "quirky.agents"],
  "contributes": {
    "method": [
      {
        "id": "create",
        "description": "Starts a structured (no PTY) Claude or Codex conversation. `deferStart` reserves a live session and lease without an initial turn; otherwise `prompt` is required. Extra arguments are refused.",
        "params": {
          "type": "object",
          "properties": {
            "worktree": { "type": "string", "description": "A worktree selector; defaults to the caller's worktree." },
            "agent": { "type": "string", "description": "The agent to run." },
            "prompt": { "type": "string" },
            "deferStart": { "type": "boolean", "description": "Reserve the live structured session and lease without sending an initial turn." },
            "title": { "type": "string", "description": "Optional session title." },
            "model": { "type": "string", "description": "A model ID from the agent's catalog, 1 to 128 characters." },
            "options": {
              "type": "object",
              "additionalProperties": true,
              "description": "Launch option picks by option ID, such as { \"effort\": \"high\" }: up to 16 entries, each a string or a boolean."
            },
            "extraArgs": { "type": "string", "description": "Refused: a structured session has no command line." }
          },
          "required": ["agent"]
        },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "kind": { "type": "string", "enum": ["terminal", "structured"] },
            "agent": { "type": "string", "description": "The agent to run." },
            "worktreeId": { "type": "string" },
            "cwd": { "type": "string" },
            "title": { "type": "string" },
            "status": { "type": "string", "enum": ["starting", "running", "working", "waiting", "done", "exited"] },
            "createdAt": { "type": "number" },
            "lastActivityAt": { "type": "number" },
            "exitCode": { "description": "The exit code, or null while the process is alive." },
            "exitSignal": { "description": "The signal that ended the process, or null." },
            "exitCause": { "description": "Why the session ended (exited, killed, host-restart or host-lost), or null while it is alive." },
            "restorable": { "type": "boolean", "description": "True when the session ended with the PTY host and can be restored." }
          },
          "required": ["id", "kind", "agent", "worktreeId", "cwd", "title", "status", "createdAt", "lastActivityAt", "exitCode"]
        }
      },
      {
        "id": "messages",
        "description": "The messages of a structured session, optionally only those after `afterSeq`.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "session": { "type": "string" },
            "afterSeq": { "type": "integer", "minimum": 0 }
          },
          "required": ["session"]
        },
        "result": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "sessionId": { "type": "string" },
              "seq": { "type": "integer" },
              "role": { "type": "string", "enum": ["user", "assistant", "tool", "system", "result"] },
              "text": { "type": "string" },
              "data": { "description": "The agent's raw event." },
              "at": { "type": "number" }
            },
            "required": ["sessionId", "seq", "role", "text", "at"]
          }
        }
      },
      {
        "id": "resume",
        "description": "Resumes the persisted native Claude or Codex conversation into a new structured session; the optional prompt starts its first turn.",
        "params": {
          "type": "object",
          "properties": {
            "session": { "type": "string", "description": "The structured session to resume." },
            "prompt": { "type": "string", "description": "Optional first prompt; omit to connect idle and send later." }
          },
          "required": ["session"]
        },
        "result": {
          "type": "object",
          "properties": {
            "id": { "type": "string" },
            "kind": { "type": "string", "enum": ["structured"] },
            "agent": { "type": "string", "enum": ["claude", "codex"] },
            "worktreeId": { "type": "string" },
            "cwd": { "type": "string" },
            "title": { "type": "string" },
            "status": { "type": "string", "enum": ["starting", "running", "working", "waiting", "done", "exited"] },
            "createdAt": { "type": "number" },
            "lastActivityAt": { "type": "number" },
            "exitCode": { "description": "The exit code, or null while the process is alive." },
            "launchSettings": { "description": "The original catalog launch snapshot." },
            "providerSession": { "description": "The native provider conversation identity." },
            "resumedFrom": { "type": "string", "description": "The Quirky session this record resumes." }
          },
          "required": ["id", "kind", "agent", "worktreeId", "cwd", "title", "status"]
        }
      },
      {
        "id": "stop",
        "description": "Stops a structured provider connection without removing its session record or journal.",
        "params": {
          "type": "object",
          "properties": {
            "session": { "type": "string" },
            "expectedIncarnation": { "type": "string", "description": "Stops only this exact live lease incarnation." }
          },
          "required": ["session"]
        },
        "result": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "closed": { "type": "boolean" },
            "sessionId": { "type": "string" },
            "processIncarnation": { "type": "string" },
            "reason": { "type": "string", "enum": ["recipient_changed", "recipient_gone"] }
          },
          "required": ["ok"]
        }
      },
      {
        "id": "send",
        "description": "Sends a message to a structured session.",
        "params": {
          "type": "object",
          "properties": {
            "session": { "type": "string" },
            "text": { "type": "string" },
            "expectedIncarnation": { "type": "string", "description": "When present, sends only to this live structured lease incarnation." },
            "operationId": { "type": "string", "description": "Optional durable idempotency key for exact retry; reusing it with different input is refused." }
          },
          "required": ["session", "text"]
        },
        "result": {
          "type": "object",
          "properties": {
            "ok": { "type": "boolean" },
            "reason": { "type": "string", "enum": ["operation_unknown", "recipient_changed", "recipient_gone"] }
          },
          "required": ["ok"]
        }
      }
    ],
    "event": [
      {
        "id": "message",
        "description": "A message was added to a structured session.",
        "data": {
          "type": "object",
          "properties": {
            "message": {
              "type": "object",
              "properties": {
                "sessionId": { "type": "string" },
                "seq": { "type": "integer" },
                "role": { "type": "string", "enum": ["user", "assistant", "tool", "system", "result"] },
                "text": { "type": "string" },
                "data": { "description": "The agent's raw event." },
                "at": { "type": "number" }
              },
              "required": ["sessionId", "seq", "role", "text", "at"]
            }
          },
          "required": ["message"]
        }
      },
      {
        "id": "settled",
        "description": "A structured session finished a turn or needs input.",
        "data": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "worktreeId": { "type": "string" },
            "agent": { "type": "string" },
            "state": { "type": "string", "enum": ["done", "waiting"] },
            "lastAssistantMessage": { "description": "The text of the latest assistant message of the session since the plugin started, or null." },
            "at": { "type": "number", "description": "When the session settled, in ms since the epoch." }
          },
          "required": ["sessionId", "worktreeId", "agent", "state", "at"]
        }
      }
    ]
  }
}
