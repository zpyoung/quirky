{
  "id": "quirky.structured",
  "name": "Structured (test fake)",
  "version": "0.0.0",
  "main": "main.ts",
  "dependencies": ["quirky.session"],
  "contributes": {
    "method": [
      {
        "id": "create",
        "params": {
          "type": "object",
          "properties": {
            "worktree": { "type": "string" },
            "agent": { "type": "string" },
            "prompt": { "type": "string" }
          },
          "required": ["agent", "prompt"]
        }
      },
      {
        "id": "pointerSession",
        "params": {
          "type": "object",
          "properties": {
            "worktree": { "type": "string" },
            "status": { "type": "string" }
          }
        },
        "result": { "type": "object", "additionalProperties": true }
      },
      {
        "id": "send",
        "params": { "type": "object", "additionalProperties": true },
        "result": { "type": "object", "properties": { "ok": { "type": "boolean" } }, "required": ["ok"] }
      },
      {
        "id": "pointerSends",
        "readOnly": true,
        "params": { "type": "object" },
        "result": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      {
        "id": "stop",
        "params": { "type": "object", "additionalProperties": true },
        "result": { "type": "object", "additionalProperties": true }
      }
    ]
  }
}
