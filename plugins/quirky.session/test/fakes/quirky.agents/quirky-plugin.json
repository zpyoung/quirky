{
  "id": "quirky.agents",
  "apiVersion": "1.0.0",
  "name": "Agents (test fake)",
  "version": "0.0.0",
  "main": "main.ts",
  "activation": "startup",
  "contributes": {
    "method": [
      {
        "id": "pick",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": { "preferred": { "type": "string" }, "forAgentTab": { "type": "boolean" } }
        }
      },
      {
        "id": "get",
        "readOnly": true,
        "params": { "type": "object", "properties": { "agent": { "type": "string" } }, "required": ["agent"] }
      },
      {
        "id": "plan",
        "description": "Shows an agent launch without starting it: no session, trust record, or hooks.",
        "readOnly": true,
        "params": {
          "type": "object",
          "properties": {
            "agent": { "type": "string" },
            "prompt": { "type": "string" },
            "submitPrompt": { "type": "boolean" },
            "cwd": { "type": "string" },
            "model": { "type": "string" },
            "options": { "type": "object", "additionalProperties": true },
            "extraArgs": { "type": "string" }
          },
          "required": ["agent"]
        },
        "result": {
          "type": "object",
          "properties": {
            "agent": { "type": "string" },
            "command": { "type": "string" },
            "env": { "type": "object", "additionalProperties": true },
            "record": {
              "type": "object",
              "properties": {
                "command": { "type": "string" },
                "args": { "type": "string" },
                "env": { "type": "object", "additionalProperties": true }
              },
              "required": ["command", "args", "env"]
            },
            "promptDelivery": {},
            "paste": {},
            "launchSettings": {}
          },
          "required": ["agent", "command", "env", "record", "promptDelivery", "paste", "launchSettings"]
        }
      },
      {
        "id": "resolveLaunch",
        "params": {
          "type": "object",
          "properties": {
            "agent": { "type": "string" },
            "model": { "type": "string" },
            "options": { "type": "object", "additionalProperties": true },
            "structured": { "type": "boolean" }
          },
          "required": ["agent", "structured"]
        }
      },
      {
        "id": "prepareLaunch",
        "params": {
          "type": "object",
          "properties": {
            "agent": { "type": "string" },
            "cwd": { "type": "string" },
            "prompt": { "type": "string" },
            "submitPrompt": { "type": "boolean" },
            "hookArgs": { "type": "array", "items": { "type": "string" } },
            "hookEnv": { "type": "object", "additionalProperties": true }
          },
          "required": ["agent", "cwd", "hookArgs", "hookEnv"]
        }
      },
      {
        "id": "prepareResume",
        "params": {
          "type": "object",
          "properties": {
            "agent": { "type": "string" },
            "cwd": { "type": "string" },
            "record": {},
            "providerSession": {
              "type": "object",
              "properties": { "id": { "type": "string" }, "transcriptPath": {} },
              "required": ["id"]
            },
            "fork": { "type": "boolean" },
            "hookArgs": { "type": "array", "items": { "type": "string" } },
            "hookEnv": { "type": "object", "additionalProperties": true }
          },
          "required": ["agent", "cwd", "providerSession", "fork", "hookArgs", "hookEnv"]
        }
      },
      {
        "id": "deliver",
        "params": {
          "type": "object",
          "properties": {
            "sessionId": { "type": "string" },
            "agent": { "type": "string" },
            "text": { "type": "string" },
            "submit": { "type": "boolean" }
          },
          "required": ["sessionId", "agent", "text", "submit"]
        }
      }
    ]
  }
}
